    "CryptoSettings.Parallelism.instructions %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "جهازك يحتوي على **%lld نواة**. زيادة عدد المهام المتوازية يمكن أن **تسرّع التشفير**، لكنها قد تستهلك المزيد من البطارية."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "جهازك يحتوي على **%lld نواة**. زيادة عدد المهام المتوازية يمكن أن **تسرّع التشفير**، لكنها قد تستهلك المزيد من البطارية."
                }
              }
            }
          }
        },
        "az" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cihazınızın **%lld nüvəsi** var. Paralel tapşırıqların sayını artırmaq **şifrələməni sürətləndirə** bilər, lakin batareya sərfiyyatını da artıra bilər."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cihazınızın **%lld nüvəsi** var. Paralel tapşırıqların sayını artırmaq **şifrələməni sürətləndirə** bilər, lakin batareya sərfiyyatını da artıra bilər."
                }
              }
            }
          }
        },
        "be" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ваша прылада мае **%lld ядры**. Павелічэнне ліку паралельных задач можа **паскорыць шыфраванне**, але спажывае больш батарэі."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ваша прылада мае **%lld ядзер**. Павелічэнне ліку паралельных задач можа **паскорыць шыфраванне**, але спажывае больш батарэі."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ваша прылада мае **%lld ядро**. Павелічэнне ліку паралельных задач можа **паскорыць шыфраванне**, але спажывае больш батарэі."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ваша прылада мае **%lld ядзер**. Павелічэнне ліку паралельных задач можа **паскорыць шыфраванне**, але спажывае больш батарэі."
                }
              }
            }
          }
        },
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "আপনার ডিভাইসে **%lld টি কোর** রয়েছে। সমান্তরাল কাজের সংখ্যা বাড়ালে **এনক্রিপশন দ্রুততর** হতে পারে, তবে বেশি ব্যাটারি খরচ হতে পারে।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "আপনার ডিভাইসে **%lld টি কোর** রয়েছে। সমান্তরাল কাজের সংখ্যা বাড়ালে **এনক্রিপশন দ্রুততর** হতে পারে, তবে বেশি ব্যাটারি খরচ হতে পারে।"
                }
              }
            }
          }
        },
        "ca" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El teu dispositiu té **%lld nucli**. Augmentar el nombre de tasques en paral·lel pot **accelerar el xifratge**, però pot consumir més bateria."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El teu dispositiu té **%lld nuclis**. Augmentar el nombre de tasques en paral·lel pot **accelerar el xifratge**, però pot consumir més bateria."
                }
              }
            }
          }
        },
        "cs" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vaše zařízení má **%lld jádra**. Zvýšení počtu paralelních úloh může **zrychlit šifrování**, ale může spotřebovat více baterie."
                }
              },
              "one" : {
                "stringUnit" : {
