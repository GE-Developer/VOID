    "CryptoSettings.Layers.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El **nombre màxim de capes depèn de la longitud de la clau** que seleccionis. Una clau més llarga permet més capes i augmenta la protecció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximální **počet vrstev závisí na délce klíče**, kterou zvolíte. Delší klíč umožní více vrstev a zvýší ochranu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det maksimale **antal lag afhænger af den nøglelængde**, du vælger. En længere nøgle tillader flere lag og styrker din beskyttelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die maximale **Anzahl der Schichten hängt von der gewählten Schlüssellänge** ab. Ein längerer Schlüssel ermöglicht mehr Schichten und erhöht so den Schutz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο μέγιστος **αριθμός στρώσεων εξαρτάται από το μήκος κλειδιού** που επιλέγετε. Ένα μεγαλύτερο κλειδί επιτρέπει περισσότερες στρώσεις, ενισχύοντας την προστασία σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maximum **number of layers depends on the key length** you select. A longer key allows more layers, increasing your protection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El **número máximo de capas depende de la longitud de la clave** que selecciones.  \nUna clave más larga permite más capas, aumentando tu protección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kerrosmäärän enimmäisraja riippuu valitsemastasi avaimen pituudesta**. Pidempi avain mahdollistaa enemmän kerroksia ja kasvattaa suojaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre maximum de **couches dépend de la longueur de la clé** choisie. Une clé plus longue permet plus de couches, augmentant la protection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम **परतों की संख्या आपके द्वारा चुनी गई कुंजी की लंबाई पर निर्भर करती है**। लंबी कुंजी अधिक परतों की अनुमति देती है और आपकी सुरक्षा बढ़ाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimalni **broj slojeva ovisi o duljini ključa** koju odaberete. Dulji ključ omogućuje više slojeva, čime se povećava zaštita."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A maximális **rétegszám a választott kulcshosszúságtól függ**. A hosszabb kulcs több réteget tesz lehetővé, növelve a védelmet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jumlah maksimum lapisan bergantung pada panjang kunci** yang Anda pilih. Kunci yang lebih panjang memungkinkan lebih banyak lapisan, meningkatkan perlindungan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero massimo di **livelli dipende dalla lunghezza della chiave** selezionata. Una chiave più lunga permette più livelli, aumentando la protezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大**レイヤー数は選択した鍵の長さに依存します**。 鍵が長いほど使用できるレイヤーが増え、保護が強化されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაქსიმალური **შრეების რაოდენობა დამოკიდებულია გასაღები კოდის სიგრძეზე**, რომელსაც ირჩევთ. გრძელი გასაღები კოდი მეტი შრის დამატების საშუალებას იძლევა, რაც ზრდის დაცვას."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 **레이어 수는 선택한 키 길이에 따라 달라집니다**。 더 긴 키는 더 많은 레이어를 허용해 보호 수준을 높입니다。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bilangan maksimum lapisan bergantung pada panjang kunci** yang anda pilih. Kunci yang lebih panjang membenarkan lebih banyak lapisan, meningkatkan perlindungan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maximale **aantal lagen hangt af van de sleutellengte** die je kiest. Een langere sleutel maakt meer lagen mogelijk en verhoogt daarmee de bescherming."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O número máximo de **camadas depende do comprimento da chave** escolhido. Uma chave mais longa permite mais camadas, aumentando sua proteção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальное **количество слоёв зависит от выбранной длины ключа**. Чем длиннее ключ, тем больше слоёв можно использовать, повышая уровень защиты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det maximala **antalet lager beror på nyckellängden** du väljer. En längre nyckel tillåter fler lager och ökar därmed skyddet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz anahtar uzunluğuna bağlı olarak **maksimum katman sayısı** değişir. Daha uzun anahtar, daha fazla katman kullanılmasına izin verir ve korumayı artırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальна **кількість рівнів залежить від обраної довжини ключа**. Довший ключ дозволяє використовувати більше рівнів, підвищуючи захист."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số **lớp tối đa phụ thuộc vào độ dài khóa** bạn chọn. Khóa dài hơn cho phép nhiều lớp hơn, từ đó tăng cường bảo vệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的最大**层数取决于所选的密钥长度**。 密钥越长，可用的层数越多，防护也越强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援的最大**層數取決於所選的金鑰長度**。 金鑰越長，可用的層數越多，防護也越強。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maksimalt antall lag avhenger av nøkkellengden** du velger. En lengre nøkkel tillater flere lag og øker beskyttelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maksymalna liczba warstw zależy od długości klucza**, którą wybierzesz. Dłuższy klucz pozwala na więcej warstw, zwiększając ochronę."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**Numărul maxim de straturi depinde de lungimea cheii** pe care o alegi. O cheie mai lungă permite mai multe straturi, sporindu-ți protecția."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maximálny počet vrstiev závisí od dĺžky kľúča**, ktorú si zvolíš. Dlhší kľúč umožní viac vrstiev a zvýši ochranu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**จำนวนชั้นสูงสุดขึ้นอยู่กับความยาวคีย์** ที่คุณเลือก. คีย์ที่ยาวขึ้นอนุญาตให้มีชั้นมากขึ้นและเพิ่มการป้องกัน."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hámarksfjöldi laga fer eftir lykillengdinni** sem þú velur. Lengri lykill leyfir fleiri lög og eykur verndina."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maksimal qat sayı seçdiyiniz açarın uzunluğundan asılıdır**. Daha uzun açar daha çox qat əlavə etməyə imkan verir və qorunmanı artırır."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "**Շերտերի առավելագույն քանակը կախված է ձեր ընտրած բանալու երկարությունից**. Ավելի երկար բանալին հնարավորություն է տալիս ավելացնել ավելի շատ շերտեր և բարձրացնում է պաշտպանությունը."
          }
        }
      }
    },
