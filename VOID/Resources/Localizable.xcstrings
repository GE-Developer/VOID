    "Settings.Storage.ResetSettings.alertMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستعود جميع التفضيلات (السمة، اللغة، الصوت، الاهتزاز، إلخ) إلى قيمها الافتراضية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün parametrlər (tema, dil, səs, vibrasiya və s.) standart dəyərlərinə qayıdacaq."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе налады (тэма, мова, гук, гаптыка і г.д.) вернуцца да стандартных."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমস্ত পছন্দ (থিম, ভাষা, শব্দ, হ্যাপটিক্স ইত্যাদি) তাদের ডিফল্টে ফিরে যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totes les preferències (tema, idioma, so, vibració, etc.) tornaran als valors predeterminats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna nastavení (motiv, jazyk, zvuk, haptika atd.) se vrátí na výchozí hodnoty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle indstillinger (tema, sprog, lyd, haptics osv.) vender tilbage til standardværdierne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Einstellungen (Design, Sprache, Ton, Haptik usw.) werden auf die Standardwerte zurückgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι προτιμήσεις (θέμα, γλώσσα, ήχος, haptics κ.λπ.) θα επιστρέψουν στις προεπιλεγμένες τιμές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All preferences (theme, language, sound, haptics, etc.) will return to their defaults."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las preferencias (tema, idioma, sonido, háptica, etc.) volverán a sus valores predeterminados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki asetukset (teema, kieli, ääni, haptinen palaute jne.) palautuvat oletusarvoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les préférences (thème, langue, son, haptique, etc.) reviendront à leurs valeurs par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל ההעדפות (ערכת נושא, שפה, צליל, רטט וכו') יחזרו לברירות המחדל שלהן."
