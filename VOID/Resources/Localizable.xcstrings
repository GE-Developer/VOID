            "state" : "translated",
            "value" : "Ako to funguje?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur fungerar det?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานอย่างไร?"
          }
        },
        "tr" : {
