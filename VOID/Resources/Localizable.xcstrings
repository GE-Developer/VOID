          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "あなたのデバイスには**%lldコア**があります。 並列タスクの数を増やすと**暗号化を高速化**できますが、バッテリーをより多く消費する可能性があります。"
                }
              }
            }
          }
        },
        "ka": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "თქვენს მოწყობილობას აქვს **%lld ბირთვი**. პარალელური დავალებების რაოდენობის გაზრდა შეუძლია **შიფრაციის დასაჩქარებლად**, მაგრამ მეტ ენერგიას მოიხმარს."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "თქვენს მოწყობილობას აქვს **%lld ბირთვი**. პარალელური დავალებების რაოდენობის გაზრდა შეუძლია **შიფრაციის დასაჩქარებლად**, მაგრამ მეტ ენერგიას მოიხმარს."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
