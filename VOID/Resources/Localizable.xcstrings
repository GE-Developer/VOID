    "Project.other": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tens suggeriments, idees o correccions, contacta'ns per qualsevol via que et sigui convenient."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte-li návrhy, nápady nebo opravy, kontaktujte nás jakýmkoli způsobem, který vám vyhovuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du forslag, idéer eller rettelser, så kontakt os på den måde, der passer dig bedst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie Vorschläge, Ideen oder Korrekturen haben, kontaktieren Sie uns bitte auf eine für Sie bequeme Weise."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν έχετε προτάσεις, ιδέες ή διορθώσεις, επικοινωνήστε μαζί μας με οποιονδήποτε τρόπο σας εξυπηρετεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have any suggestions, ideas, or corrections, please contact us in any way convenient for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes alguna sugerencia, idea o corrección, contáctanos de la manera que te resulte más conveniente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sinulla on ehdotuksia, ideoita tai korjauksia, ota meihin yhteyttä sinulle sopivalla tavalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez des suggestions, des idées ou des corrections, veuillez nous contacter de la manière qui vous convient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपके पास कोई सुझाव, विचार या सुधार हैं, तो कृपया अपने लिए सुविधाजनक किसी भी तरीके से हमसे संपर्क करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako imate prijedloge, ideje ili ispravke, kontaktirajte nas na bilo koji vama prikladan način."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha javaslataid, ötleteid vagy javításaid vannak, vedd fel velünk a kapcsolatot a számodra legkényelmesebb módon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda memiliki saran, ide, atau koreksi, hubungi kami dengan cara apa pun yang paling nyaman bagi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai suggerimenti, idee o correzioni, contattaci in qualsiasi modo ti sia comodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご提案、アイデア、または訂正がある場合は、都合の良い方法でご連絡ください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ გაქვთ რაიმე შემოთავაზება, იდეა ან შესწორება, გთხოვთ, დაგვიკავშირდეთ თქვენთვის მოსახერხებელი ნებისმიერი გზით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안, 아이디어 또는 수정 사항이 있다면 편리한 방법으로 연락해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda mempunyai cadangan, idea atau pembetulan, hubungi kami melalui apa jua cara yang sesuai untuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je suggesties, ideeën of correcties hebt, neem dan contact met ons op op een manier die voor jou handig is."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você tiver sugestões, ideias ou correções, entre em contato conosco da maneira que for mais conveniente para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у вас есть предложения, идеи или исправления, свяжитесь с нами любым удобным для вас способом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du har några förslag, idéer eller korrigeringar, kontakta oss på det sätt som passar dig bäst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneri, fikir veya düzeltmeleriniz varsa, lütfen size uygun herhangi bir şekilde bizimle iletişime geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо у вас є пропозиції, ідеї чи виправлення, зв’яжіться з нами будь-яким зручним для вас способом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn có bất kỳ đề xuất, ý tưởng hoặc chỉnh sửa nào, vui lòng liên hệ với chúng tôi theo bất kỳ cách nào tiện lợi cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您有任何建议，想法或更正，请以您方便的方式联系我们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您有任何建議，想法或更正，請以您方便的方式聯繫我們。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har forslag, ideer eller korrigeringer, kontakt oss på den måten som passer deg best."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli masz sugestie, pomysły lub poprawki, skontaktuj się z nami w dowolny wygodny dla ciebie sposób."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ai sugestii, idei sau corecturi, contactează-ne prin orice mijloc îți este la îndemână."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak máš návrhy, nápady alebo opravy, kontaktuj nás akýmkoľvek spôsobom, ktorý ti vyhovuje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณมีข้อเสนอแนะ ไอเดีย หรือการแก้ไข โปรดติดต่อเราด้วยวิธีที่สะดวกสำหรับคุณ."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú hefur ábendingar, hugmyndir eða leiðréttingar, vinsamlegast hafðu samband á þann hátt sem hentar þér best."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təklif, fikir və ya düzəlişiniz varsa, sizin üçün uyğun olan üsulla bizimlə əlaqə saxlayın."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե առաջարկ, գաղափար կամ ուղղում ունեք, կապվեք մեզ հետ ձեզ հարմար եղանակով."
          }
        }
      }
    },
