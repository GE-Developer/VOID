    "CryptoSettings.Timer.instuctions": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "**Les dades es tornen inaccessibles** després del temps seleccionat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Data se po zvoleném čase stanou nedostupná**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Data bliver utilgængelige** efter den valgte tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nach der gewählten Zeit werden die Daten unzugänglich**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Τα δεδομένα γίνονται μη προσβάσιμα** μετά τον επιλεγμένο χρόνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Data becomes inaccessible** after the chosen time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los **datos se vuelven inaccesibles** después del tiempo seleccionado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Data muuttuu saavuttamattomaksi** valitun ajan jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les **données deviennent inaccessibles** après le temps choisi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए समय के बाद **डेटा अप्राप्य हो जाता है**।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Podaci postaju nedostupni** nakon odabranog vremena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "**Az adatok a kiválasztott idő után elérhetetlenné válnak.**"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Data menjadi tidak dapat diakses** setelah waktu yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**I dati diventano inaccessibili** dopo il tempo scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**データは選択した時間後にアクセスできなくなります**。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "**მონაცემები ვერ იქნება ხელმისაწვდომი** შერჩეული დროის გასვლის შემდეგ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시간이 지나면 **데이터에 접근할 수 없습니다**。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**Data menjadi tidak dapat diakses** selepas tempoh yang dipilih."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gegevens worden ontoegankelijk** na de gekozen tijd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Os dados se tornam inacessíveis** após o tempo escolhido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Данные становятся недоступными** после выбранного времени."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Data blir otillgängliga** efter den valda tiden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen süreden sonra **verilere erişilemez**."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Дані стають недоступними** після обраного часу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dữ liệu sẽ không thể truy cập** sau khoảng thời gian đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时间过后，**数据将变为不可访问**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選時間過後，**資料將變為不可訪問**。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Data blir utilgjengelig** etter tiden du velger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dane stają się niedostępne** po wybranym czasie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**Datele devin inaccesibile** după timpul ales."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dáta sa stanú nedostupnými** po zvolenom čase."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ข้อมูลจะไม่สามารถเข้าถึงได้** หลังจากเวลาที่ตั้งไว้."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gögnin verða óaðgengileg** eftir valinn tíma."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**Məlumat seçilən vaxtdan sonra əlçatmaz olur.**"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "**Տվյալները ընտրված ժամանակից հետո դառնում են անհասանելի.**"
          }
        }
      }
    },
