    "QRCode.Logo.alertMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة شعار تتطلب مستوى تصحيح أخطاء عالياً. انتقل إلى عالٍ لتضمين شعار."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loqo əlavə etmək üçün yüksək xəta düzəltmə səviyyəsi tələb olunur. Loqo yerləşdirmək üçün Yüksək səviyyəyə keçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для дадання лагатыпа патрабуецца высокі ўзровень выпраўлення памылак. Перайдзіце на High, каб уставіць лагатып."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লোগো যোগ করতে উচ্চ ত্রুটি সংশোধন স্তর প্রয়োজন। লোগো যুক্ত করতে High-তে স্যুইচ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegir un logotip requereix el nivell de correcció d'errors Alt. Canvieu a Alt per incrustar un logotip."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidání loga vyžaduje vysokou úroveň korekce chyb. Přepněte na Vysokou úroveň, abyste mohli logo vložit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjelse af et logo kræver det høje fejlkorrektionsniveau. Skift til Høj for at integrere et logo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hinzufügen eines Logos erfordert die hohe Fehlerkorrekturebene. Wechsle zu Hoch, um ein Logo einzubetten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προσθήκη λογότυπου απαιτεί υψηλό επίπεδο διόρθωσης σφαλμάτων. Μεταβείτε σε Υψηλό για να ενσωματώσετε λογότυπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding a logo requires the High error correction level. Switch to High to embed a logo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir un logotipo requiere el nivel de corrección de errores Alto. Cambia a Alto para insertar un logotipo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logon lisääminen vaatii korkean virheenkorjaustason. Vaihda Korkea-tasoon upottaaksesi logon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ajout d'un logo nécessite le niveau de correction d'erreurs Élevé. Passez en Élevé pour intégrer un logo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוספת לוגו דורשת רמת תיקון שגיאות גבוהה. עבור לגבוה כדי להטמיע לוגו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोगो जोड़ने के लिए उच्च त्रुटि सुधार स्तर आवश्यक है। लोगो एम्बेड करने के लिए उच्च पर स्विच करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodavanje loga zahtijeva visoku razinu korekcije grešaka. Prebacite se na Visoku razinu kako biste ugradili logo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A logó hozzáadásához magas hibajavítási szint szükséges. Váltson Magasra a logó beágyazásához."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լոգո ավելացնելու համար անհրաժեշտ է սխալների ուղղման բարձր մակարդակ։ Անցեք Բարձր մակարդակի, որպեսզի ներդնեք լոգո։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan logo memerlukan tingkat koreksi kesalahan Tinggi. Beralih ke Tinggi untuk menyematkan logo."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til að bæta við merki þarf hátt villuleiðréttingarstig. Skiptu yfir í Hátt til að fella inn merki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aggiunta di un logo richiede il livello di correzione degli errori Alto. Passa ad Alto per incorporare un logo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロゴを追加するには高い誤り訂正レベルが必要です。ロゴを埋め込むには「高」に切り替えてください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ლოგოს დასამატებლად საჭიროა შეცდომის კორექციის მაღალი დონე. ლოგოს ჩასმისთვის გადაერთეთ მაღალ დონეზე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логотип қосу үшін жоғары қате түзету деңгейі қажет. Логотип енгізу үшін High-ға ауысыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로고를 추가하려면 높은 오류 수정 레벨이 필요합니다. 로고를 삽입하려면 높음으로 전환하세요."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логотип кошуу үчүн жогорку катаны оңдоо деңгээли керек. Логотип киргизүү үчүн High га өтүңүз."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambah logo memerlukan aras pembetulan ralat Tinggi. Tukar kepada Tinggi untuk menyematkan logo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å legge til en logo krever høyt feilrettingsnivå. Bytt til Høy for å bygge inn en logo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor het toevoegen van een logo is het hoge foutcorrectieniveau vereist. Schakel over naar Hoog om een logo in te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodanie logo wymaga wysokiego poziomu korekcji błędów. Przełącz na Wysoki, aby osadzić logo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar um logótipo requer o nível de correção de erros Alto. Mude para Alto para incorporar um logótipo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugarea unui logo necesită nivelul înalt de corectare a erorilor. Comutați la Înalt pentru a încorpora un logo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавление логотипа требует высокого уровня коррекции ошибок. Переключитесь на высокий уровень, чтобы встроить логотип."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridanie loga vyžaduje vysokú úroveň korekcie chýb. Prepnite na Vysokú úroveň, aby ste mohli logo vložiť."
          }
        },
        "sv" : {
          "stringUnit" : {
