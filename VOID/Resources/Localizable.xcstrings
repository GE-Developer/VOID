        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убактылуу файлдар, кэш жана документ файлдары жок кылынат. Колдонмонун жөндөөлөрү сакталат."
          }
        },
        "ms" : {
          "stringUnit" : {
