    "CryptoSettings.Iterations.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre d'**iteracions** afecta la **fortalesa** del xifrat. Més = més difícil de trencar, però **més lent**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet **iterací** ovlivňuje **sílu** šifrování. Více = obtížnější prolomení, ale **pomalejší**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Antallet af **iterationer** påvirker **styrken** af krypteringen. Flere = sværere at knække, men **langsommere**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzahl der **Iterationen** beeinflusst die **Stärke** der Verschlüsselung. Mehr Iterationen = schwerer zu knacken, aber **langsamer**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός των **επαναλήψεων** επηρεάζει τη **δύναμη** της κρυπτογράφησης. Περισσότερες = πιο δύσκολο να παραβιαστεί, αλλά **πιο αργό**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of **iterations** affects encryption **strength**. More = harder to crack, but **slower**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de **iteraciones** afecta la **fuerza** del cifrado.  \nMás iteraciones = más difícil de descifrar, pero **más lento**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Iteraatioiden määrä** vaikuttaa salauksen **vahvuuteen**. Enemmän = vaikeampi murtaa, mutta **hitaampi**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre d'**itérations** influence la **force** du chiffrement. Plus d'itérations = plus difficile à craquer, mais **plus lent**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**पुनरावृत्तियों** की संख्या एन्क्रिप्शन की **मज़बूती** को प्रभावित करती है। जितनी अधिक होंगी = तोड़ना उतना कठिन, लेकिन **गति धीमी**।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj **iteracija** utječe na **snagu** šifriranja. Više = teže probiti, ali **sporije**."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az **iterációk száma** befolyásolja a titkosítás **erősségét**. Több = nehezebb feltörni, de **lassabb**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah **iterasi** memengaruhi **kekuatan** enkripsi. Lebih banyak = lebih sulit dibobol, tetapi **lebih lambat**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero di **iterazioni** influisce sulla **forza** della cifratura. Più iterazioni = più difficile da decifrare, ma **più lento**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**反復回数**は暗号化の**強度**に影響します。 回数が多いほど解読は難しくなりますが、**処理は遅く**なります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "**იტერაციების რაოდენობა** გავლენას ახდენს **შიფრაციის სიმტკიცეზე**. რაოდენობის გაზრდა ართულებს დაშიფვრას, მაგრამ **ამცირებს სიჩქარეს**."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**반복 횟수**는 암호화의 **강도**에 영향을 줍니다。 횟수가 많을수록 풀기 어렵지만 **속도는 느려집니다**。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangan **iterasi** mempengaruhi **kekuatan** penyulitan. Lebih banyak = lebih sukar dipecahkan, tetapi **lebih perlahan**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aantal **iteraties** beïnvloedt de **sterkte** van de versleuteling. Meer = moeilijker te kraken, maar **langzamer**."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**O número de iterações** afeta a **força** da criptografia. Quanto maior, mais difícil de quebrar, porém **mais lento**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Количество итераций** влияет на **силу** шифрования: чем больше итераций, тем сложнее взломать, но тем **медленнее** процесс шифрования и расшифровки данных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Antalet **iterationer** påverkar krypteringens **styrka**. Fler = svårare att knäcka, men **långsammare**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**İterasyon sayısı** şifrelemenin **gücünü** etkiler. Daha fazla = kırması zor, ancak **daha yavaş**."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість **ітерацій** впливає на **стійкість** шифрування. Більше = складніше зламати, але **повільніше**."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Số vòng lặp** ảnh hưởng đến **độ mạnh** của mã hóa. Vòng lặp càng nhiều thì càng khó bẻ khóa nhưng quá trình sẽ **chậm hơn**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**迭代次数**会影响加密的**强度**。 迭代越多，越难破解，但速度会**变慢**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**迭代次數**會影響加密的**強度**。 迭代越多，越難破解，但速度會**變慢**。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Antallet **iterasjoner** påvirker **styrken** på krypteringen. Flere = vanskeligere å knekke, men **langsommere**."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba **iteracji** wpływa na **siłę** szyfrowania. Więcej = trudniej złamać, ale **wolniej**."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul de **iterații** influențează **puterea** criptării. Mai multe = mai greu de spart, dar **mai lent**."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet **iterácií** ovplyvňuje **silou** šifrovania. Viac = ťažšie prelomiť, ale **pomalšie**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวน **รอบ** มีผลต่อ **ความแข็งแกร่ง** ของการเข้ารหัส. ยิ่งมาก = ยากต่อการถอด แต่ **ช้าลง**."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjöldi **ítrana** hefur áhrif á **styrk** dulkóðunar. Meira = erfiðara að brjóta, en **hægara**."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**İterasiya sayı** şifrələmənin **gücünə** təsir edir. Daha çox = sındırmaq çətindir, lakin **daha yavaşdır**."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "**Իտերացիաների քանակը** ազդում է կոդավորման **ուժի** վրա. Ավելի շատ = կոտրելն ավելի դժվար է, բայց **ավելի դանդաղ**."
          }
        }
      }
    },
