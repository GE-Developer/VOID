    "AboutEmoji.tipsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "**No facis servir la codificació amb emojis per protegir informació sensible**.  Per transmetre dades de manera segura, és millor **combinar-la amb xifratge** — per exemple, xifra primer el text i després converteix el resultat en emojis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nepoužívejte kódování pomocí emoji k ochraně citlivých informací**.  Pro bezpečný přenos dat je lepší jej **kombinovat se šifrováním** — například nejprve text zašifrovat a poté výsledek převést na emoji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Brug ikke emoji-kodning til at beskytte følsomme oplysninger**.  For sikker dataoverførsel er det bedre **at kombinere den med kryptering** — eksempelvis krypter teksten først og konverter derefter resultatet til emojis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Verwenden Sie keine Emoji-Codierung zum Schutz sensibler Informationen**.  Für eine sichere Datenübertragung ist es besser, **es mit Verschlüsselung zu kombinieren** — z. B. den Text zuerst verschlüsseln und dann das Ergebnis in Emojis umwandeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Μην χρησιμοποιείτε την κωδικοποίηση με emoji για την προστασία ευαίσθητων πληροφοριών**.  Για ασφαλή μετάδοση δεδομένων είναι καλύτερο να την **συνδυάζετε με κρυπτογράφηση** — για παράδειγμα, κρυπτογραφήστε πρώτα το κείμενο και στη συνέχεια μετατρέψτε το αποτέλεσμα σε emoji."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Do not use emoji encoding to protect sensitive information**.  For secure data transmission, it’s better to **combine it with encryption** — for example, encrypt the text first and then convert the result into emojis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**No uses la codificación con emojis para proteger información sensible**.  Para la transmisión segura de datos, es mejor **combinarla con cifrado** — por ejemplo, primero cifrar el texto y luego convertir el resultado en emojis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Älä käytä emoji-koodausta arkaluonteisen tiedon suojaamiseen**.  Turvallista tiedonsiirtoa varten se on parempi **yhdistää salaukseen** — esimerkiksi salaa teksti ensin ja muuta sitten tulos emojeiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**N'utilisez pas le codage par emoji pour protéger des informations sensibles**.  Pour une transmission sécurisée des données, il est préférable de **le combiner avec un chiffrement** — par exemple, chiffrer d'abord le texte, puis convertir le résultat en emojis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**संवेदनशील जानकारी की सुरक्षा के लिए इमोजी एन्कोडिंग का उपयोग न करें**।  सुरक्षित डेटा ट्रांसमिशन के लिए, इसे **एन्क्रिप्शन के साथ संयोजित करना** बेहतर है — उदाहरण के लिए, पहले टेक्स्ट को एन्क्रिप्ट करें और फिर परिणाम को इमोजी में बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ne koristite kodiranje emojijima za zaštitu osjetljivih informacija**.  Za siguran prijenos podataka bolje ga je **kombinirati sa šifriranjem** — na primjer, najprije šifrirajte tekst, a zatim rezultat pretvorite u emojije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ne használd az emoji-kódolást érzékeny információk védelmére**.  Biztonságos adattovábbításhoz jobb, ha **titkosítással kombinálod** — például először titkosítsd a szöveget, majd az eredményt alakítsd emoijokká."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jangan gunakan pengodean emoji untuk melindungi informasi sensitif**.  Untuk transmisi data yang aman, lebih baik **menggabungkannya dengan enkripsi** — misalnya enkripsi teks terlebih dahulu lalu ubah hasilnya menjadi emoji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Non utilizzare la codifica con emoji per proteggere informazioni sensibili**.  Per una trasmissione sicura dei dati, è meglio **combinarla con la crittografia** — ad esempio, cifrare prima il testo e poi convertire il risultato in emoji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**機密情報を保護するために絵文字エンコーディングを使用しないでください**。  安全なデータ送信のためには、**暗号化と組み合わせる方が良い**です — 例えば、テキストをまず暗号化し、その後結果を絵文字に変換します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "**არ გამოიყენოთ ემოჯის კოდირება მგრძნობიარე ინფორმაციის დასაცავად.  **უსაფრთხო მონაცემთა გადაცემისთვის უმჯობესია **შიფრაციასთან კომბინაცია** — მაგალითად, ჯერ დაშიფრეთ ტექსტი და შემდეგ გადააქციეთ შედეგი ემოჯებად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**민감한 정보를 보호하기 위해 이모지 인코딩을 사용하지 마세요**。  데이터를 안전하게 전송하려면, **암호화와 결합하는 것이 좋습니다** — 예를 들어, 먼저 텍스트를 암호화한 후 결과를 이모지로 변환합니다。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jangan gunakan pengekodan emoji untuk melindungi maklumat sensitif**.  Untuk penghantaran data yang selamat, lebih baik **gabungkannya dengan penyulitan** — contohnya enkripsi teks terlebih dahulu kemudian tukar hasilnya kepada emoji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gebruik geen emoji-codering om gevoelige informatie te beschermen**.  Voor veilige gegevensoverdracht is het beter om **het met encryptie te combineren** — bijvoorbeeld eerst de tekst versleutelen en vervolgens het resultaat naar emoji's converteren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Não use codificação por emoji para proteger informações sensíveis**.  Para transmissão segura de dados, é melhor **combiná-la com criptografia** — por exemplo, criptografar o texto primeiro e depois converter o resultado em emojis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Не используйте кодирование в эмоджи для защиты важной информации**.  Для безопасной передачи данных лучше **сочетать его с шифрованием** — например, сначала зашифровать текст, а затем преобразовать результат в эмоджи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Använd inte emoji-kodning för att skydda känslig information**.  För säker datatransmission är det bättre att **kombinera den med kryptering** — till exempel kryptera texten först och sedan konvertera resultatet till emojis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hassas bilgileri korumak için emoji kodlaması kullanmayın**.  Güvenli veri iletimi için, **bunu şifreleme ile birleştirmek** daha iyidir — örneğin, önce metni şifreleyin ve ardından sonucu emojilere dönüştürün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Не використовуйте кодування емодзі для захисту конфіденційної інформації**.  Для безпечної передачі даних краще **поєднувати його з шифруванням** — наприклад, спочатку зашифрувати текст, а потім перетворити результат на емодзі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Không sử dụng mã hóa bằng emoji để bảo vệ thông tin nhạy cảm**.  Để truyền dữ liệu an toàn, tốt hơn là **kết hợp nó với mã hóa** — ví dụ, trước tiên mã hóa văn bản, sau đó chuyển kết quả thành emoji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**不要使用表情符号编码来保护敏感信息**。  为了安全地传输数据，最好**将其与加密结合使用** — 例如，先加密文本，然后将结果转换为表情符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**不要使用表情符號編碼來保護敏感信息**。  為了安全傳輸數據，最好**將其與加密結合使用**—例如，先加密文本，然後將結果轉換為表情符號。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ikke bruk emoji-koding til å beskytte sensitiv informasjon**.  For sikker dataoverføring er det bedre å **kombinere den med kryptering** — for eksempel krypter teksten først, og konverter deretter resultatet til emoji."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nie używaj kodowania emoji do ochrony wrażliwych informacji**.  Aby bezpiecznie przesyłać dane, najlepiej **połączyć je z szyfrowaniem** — na przykład najpierw zaszyfruj tekst, a następnie zamień wynik na emoji."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nu folosi codificarea cu emoji pentru a proteja informații sensibile**.  Pentru transmiterea sigură a datelor, este mai bine să o **combini cu criptarea** — de exemplu, criptează mai întâi textul și abia apoi transformă rezultatul în emoji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nepoužívaj kódovanie emoji na ochranu citlivých informácií**.  Pre bezpečný prenos dát je lepšie **skombinovať ho so šifrovaním** — napríklad najprv text zašifruj a až potom ho premeň na emoji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**อย่าใช้การเข้ารหัสอีโมจิเพื่อปกป้องข้อมูลที่ละเอียดอ่อน**.  สำหรับการส่งข้อมูลอย่างปลอดภัย ควร **ผสานกับการเข้ารหัส** — เช่น เข้ารหัสข้อความก่อน แล้วค่อยแปลงผลลัพธ์เป็นอีโมจิ."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ekki nota emoji-kóðun til að vernda viðkvæmar upplýsingar**.  Til öruggrar gagnaflutnings er betra að **sameina hana við dulkóðun** — til dæmis dulritaðu textann fyrst og breyttu síðan niðurstöðunni í emoji."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**Emoji kodlaşdırmadan məxfi məlumatı qorumaq üçün istifadə etməyin**.  Məlumatı təhlükəsiz ötürmək üçün onu **şifrələmə ilə birləşdirmək daha yaxşıdır** — məsələn, əvvəlcə mətni şifrələyin, sonra nəticəni emoji-lərə çevirin."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "**Emoji կոդավորումը մի օգտագործեք գաղտնի տվյալները պաշտպանելու համար**.  Տվյալները անվտանգ փոխանցելու համար այն ավելի լավ է **միավորել կոդավորման հետ** — օրինակ, նախ կոդավորեք տեքստը, հետո արդյունքը փոխակերպեք emoji-ների."
          }
        }
      }
    },
