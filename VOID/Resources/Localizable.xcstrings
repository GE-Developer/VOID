    "AboutEmoji.aboutDescription": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La codificació amb emoji és **un mètode de representació visual de les dades** on el text es converteix en una seqüència d'emojis.  **Aquesta codificació no és criptogràfica i no proporciona protecció de dades**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kódování pomocí emoji je **metoda vizuálního zobrazení dat**, kdy se text převádí na posloupnost emoji.  **Toto kódování není kryptografické a neposkytuje ochranu dat**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-kodning er **en metode til visuelt at repræsentere data**, hvor tekst konverteres til en sekvens af emojis.  **Denne kodning er ikke kryptografisk og giver ingen databeskyttelse**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-Codierung ist **eine Methode zur visuellen Darstellung von Daten**, bei der Text in eine Reihe von Emojis umgewandelt wird.  **Diese Codierung ist nicht kryptografisch und bietet keinen Datenschutz**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κωδικοποίηση με emoji είναι **ένας τρόπος οπτικής αναπαράστασης των δεδομένων**, όπου το κείμενο μετατρέπεται σε ακολουθία emoji.  **Η κωδικοποίηση αυτή δεν είναι κρυπτογραφική και δεν παρέχει προστασία δεδομένων**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji encoding is **a method of visually representing data** where text is converted into a sequence of emojis.  **This encoding is not cryptographic and does not provide data protection**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La codificación con emojis es **un método de representación visual de datos**, donde el texto se convierte en una secuencia de emojis.  **Esta codificación no es criptográfica y no proporciona protección de datos**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-koodaus on **tapa esittää dataa visuaalisesti**, jossa teksti muunnetaan emojien jonoiksi.  **Tämä koodaus ei ole kryptografinen eikä suojaa dataa**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le codage par emoji est **une méthode de représentation visuelle des données**, où le texte est converti en une séquence d'emojis.  **Ce codage n'est pas cryptographique et ne protège pas les données**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमोजी एन्कोडिंग **डेटा को दृश्य रूप में प्रस्तुत करने की एक विधि** है, जिसमें टेक्स्ट को इमोजी की एक श्रृंखला में परिवर्तित किया जाता है।  **यह एन्कोडिंग क्रिप्टोग्राफिक नहीं है और डेटा सुरक्षा प्रदान नहीं करती है**।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodiranje emojijima je **metoda vizualnog predstavljanja podataka** kojom se tekst pretvara u niz emojija.  **Ovo kodiranje nije kriptografsko i ne pruža zaštitu podataka**."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emoji-kódolás **az adatok vizuális megjelenítésének egyik módja**, ahol a szöveg egy emoji-sorozattá alakul.  **Ez a kódolás nem kriptográfiai és nem nyújt adatvédelmet.**"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengodean emoji adalah **metode representasi visual data** di mana teks diubah menjadi rangkaian emoji.  **Pengodean ini bukan kriptografi dan tidak memberikan perlindungan data.**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La codifica con emoji è **un metodo per rappresentare visivamente i dati**, dove il testo viene convertito in una sequenza di emoji.  **Questa codifica non è crittografica e non fornisce protezione dei dati**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字エンコーディングは、テキストを絵文字のシーケンスに変換する**データを視覚的に表現する方法**です。  **このエンコーディングは暗号化ではなく、データ保護を提供しません**。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ემოჯის კოდირება **მონაცემთა ვიზუალური წარმოდგენის მეთოდია**, სადაც ტექსტი გარდაიქმნება ემოჯების თანმიმდევრობად.  **ეს კოდირება არ არის კრიპტოგრაფიული და არ უზრუნველყოფს მონაცემთა დაცვას**."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지 인코딩은 텍스트를 이모지 시퀀스로 변환하는 **데이터를 시각적으로 표현하는 방법**입니다。\n\n**이 인코딩은 암호화가 아니며 데이터 보호를 제공하지 않습니다**。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengekodan emoji ialah **kaedah representasi visual data** di mana teks ditukar menjadi jujukan emoji.  **Pengekodan ini bukan kriptografi dan tidak memberikan perlindungan data.**"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-codering is **een methode om gegevens visueel weer te geven**, waarbij tekst wordt omgezet in een reeks emoji's.  **Deze codering is niet cryptografisch en biedt geen gegevensbescherming**."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A codificação por emoji é **um método de representação visual de dados**, onde o texto é convertido em uma sequência de emojis.  **Essa codificação não é criptográfica e não fornece proteção de dados**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодирование в эмоджи —  **это способ визуального представления данных**, при котором текст преобразуется в последовательность эмоджи.  **Такое кодирование не является криптографическим и не обеспечивает защиту данных**."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-kodning är **en metod för att visuellt representera data**, där text omvandlas till en sekvens av emojis.  **Denna kodning är inte kryptografisk och ger inget dataskydd**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji kodlaması, metnin bir dizi emojiye dönüştürüldüğü **verileri görsel olarak temsil etme yöntemi**dir.  **Bu kodlama kriptografik değildir ve veri koruması sağlamaz**."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодування емодзі — це **метод візуального подання даних**, коли текст перетворюється на послідовність емодзі.  **Це кодування не є криптографічним і не забезпечує захист даних**."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã hóa bằng emoji là **một phương pháp biểu diễn dữ liệu trực quan**, nơi văn bản được chuyển đổi thành một chuỗi emoji.  **Mã hóa này không phải là mã hóa và không cung cấp bảo vệ dữ liệu**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表情符号编码是一种**以可视化方式表示数据的方法**，文本会被转换为一系列表情符号。  **这种编码不是加密方法，也不能提供数据保护**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表情符號編碼是一種**以可視化方式表示數據的方法**，文本會被轉換為一系列表情符號。  **這種編碼不是加密方法，也不能提供數據保護**。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-koding er en **måte å representere data visuelt** på der tekst konverteres til en sekvens av emoji.  **Denne kodingen er ikke kryptografisk og gir ingen databeskyttelse.**"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodowanie emoji to **metoda wizualnej reprezentacji danych**, w której tekst zamieniany jest na sekwencję emoji.  **To kodowanie nie jest kryptograficzne i nie zapewnia ochrony danych.**"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codificarea cu emoji este **o metodă de reprezentare vizuală a datelor**, prin care textul este transformat într-o secvență de emoji.  **Această codificare nu este criptografică și nu oferă protecție pentru date.**"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kódovanie pomocou emoji je **spôsob vizuálnej reprezentácie dát**, pri ktorom sa text mení na postupnosť emoji.  **Nejde o kryptografické kódovanie a neponúka ochranu dát.**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้ารหัสด้วยอีโมจิเป็น **วิธีการแสดงข้อมูลเชิงภาพ** ที่เปลี่ยนข้อความให้เป็นลำดับของอีโมจิ.  **การเข้ารหัสนี้ไม่ใช่การเข้ารหัสเชิงคริปโตและไม่ให้การปกป้องข้อมูล**."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-kóðun er **leið til að birta gögn sjónrænt** þar sem texta er breytt í röð af emoji.  **Þessi kóðun er ekki kryptógrafísk og veitir enga gagnavernd.**"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji kodlaşdırması **məlumatın vizual nümayişi üsuludur**, burada mətn emoji ardıcıllığına çevrilir.  **Bu kodlaşdırma kriptoqrafik deyil və məlumatı qorumaq üçün nəzərdə tutulmayıb.**"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji կոդավորումը **տվյալների տեսողական ներկայացման մեթոդ է**, որտեղ տեքստը վերածվում է emoji-ների հաջորդականության.  **Այս կոդավորումը կրիպտոգրաֆիկ չէ և նախատեսված չէ տվյալների պաշտպանության համար.**"
          }
        }
      }
    },
