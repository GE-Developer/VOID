    "Home.Symmetric.description": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La mateixa clau a banda i banda del procés de xifratge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejný klíč na obou stranách procesu šifrování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den samme nøgle på begge sider af krypteringsprocessen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gleiche Schlüssel auf beiden Seiten des Verschlüsselungsprozesses."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ίδιο κλειδί και στις δύο πλευρές της διαδικασίας κρυπτογράφησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same key on both sides of the encryption process."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma clave en ambos lados del proceso de cifrado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama avain salausprosessin molemmilla puolilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même clé des deux côtés du processus de chiffrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एन्क्रिप्शन प्रक्रिया के दोनों पक्षों में समान कुंजी का उपयोग किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isti ključ na obje strane procesa šifriranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanaz a kulcs a titkosítási folyamat mindkét oldalán."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci yang sama di kedua sisi proses enkripsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stessa chiave su entrambi i lati del processo di crittografia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化プロセスの両側で同じキーを使用します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთი და იგივე გასაღები კოდი გამოიყენება შიფრაციის პროცესის ორივე მხარეს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화 과정의 양쪽에서 동일한 키를 사용합니다。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci yang sama pada kedua-dua sisi proses penyulitan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde sleutel aan beide kanten van het versleutelingsproces."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma chave em ambos os lados do processo de criptografia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одинаковый ключ на обеих сторонах процесса шифрования."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma nyckel på båda sidor av krypteringsprocessen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreleme işleminin her iki tarafında da aynı anahtar kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один і той самий ключ використовується з обох боків процесу шифрування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng một khóa được sử dụng ở cả hai phía của quá trình mã hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密过程的两端使用相同的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在加密過程的兩端使用相同的密鑰。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme nøkkel på begge sider av krypteringsprosessen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam klucz po obu stronach procesu szyfrowania."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceeași cheie pe ambele părți ale procesului de criptare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten istý kľúč na oboch stranách procesu šifrovania."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้คีย์เดียวกันทั้งสองด้านของกระบวนการเข้ารหัส."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sami lykill er notaður báðum megin við dulkóðunarferlið."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrələmə prosesinin hər iki tərəfində eyni açardan istifadə olunur."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կոդավորման գործընթացի երկու կողմերում էլ օգտագործվում է նույն բանալին."
          }
        }
      }
    },
