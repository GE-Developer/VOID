    "EmojiSettings.EmojiSelection.description": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el **tipus d'emoji** per codificar el text en una seqüència d'emojis única.  La descodificació del text de qualsevol tipus d'emoji es fa **automàticament**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte **typ emoji**, do kterého chcete text zakódovat do jedinečné sekvence.  Dekódování textu z jakéhokoli typu emoji probíhá **automaticky**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg **typen af emoji** for at kode teksten til en unik sekvens af emojis.  Afkodning af tekst fra enhver type emoji sker **automatisk**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den **Emoji-Typ**, um Text in eine einzigartige Emoji-Sequenz zu kodieren.  Die Dekodierung aus jedem Emoji-Typ erfolgt **automatisch**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τον **τύπο emoji** για να κωδικοποιήσετε το κείμενο σε μια μοναδική ακολουθία emoji.  Η αποκωδικοποίηση κειμένου από οποιονδήποτε τύπο emoji πραγματοποιείται **αυτόματα**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the **type of emoji** to encode text into a unique emoji sequence.  Decoding text from any emoji type happens **automatically**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el **tipo de emoji** para codificar el texto en una secuencia única de emoji.  La decodificación del texto desde cualquier tipo de emoji ocurre **automáticamente**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse **emoji-tyyppi**, johon koodaat tekstin ainutlaatuiseksi emojijonoksi.  Tekstin dekoodaus mistä tahansa emoji-tyypistä tapahtuu **automaattisesti**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le **type d'emoji** pour encoder le texte en une séquence d'emoji unique.  Le décodage du texte à partir de n'importe quel type d'emoji se fait **automatiquement**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**इमोजी का प्रकार** चुनें ताकि पाठ को एक अनोखी इमोजी श्रृंखला में एन्कोड किया जा सके।  किसी भी इमोजी प्रकार से पाठ डिकोड करना **स्वचालित रूप से** होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite **vrstu emodžija** kako biste tekst kodirali u jedinstveni niz emodžija.  Dekodiranje teksta iz bilo koje vrste emodžija odvija se **automatski**."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki az **emoji típusát**, amelybe a szöveget egyedi emoji sorozattá kódolod.  A bármely emoji típusból történő visszafejtés **automatikusan** megtörténik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih **jenis emoji** untuk mengodekan teks menjadi rangkaian emoji unik.  Dekode teks dari jenis emoji apa pun terjadi **secara otomatis**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona il **tipo di emoji** per codificare il testo in una sequenza di emoji unica.  La decodifica del testo da qualsiasi tipo di emoji avviene **automaticamente**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストをユニークな絵文字シーケンスにエンコードするには、**使用する絵文字の種類**を選択してください。  どの種類の絵文字でも、テキストのデコードは**自動的に**行われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ **ემოჯის ტიპი**, რათა ტექტი უნიკალურ ემოჯი-სექვენციად დააკოდოთ.  ნებისმიერი ტიპის ემოჯიდან ტექსტის დეკოდირება ხდება **ავტომატურად**."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 고유한 이모지 시퀀스로 인코딩하기 위해 **이모지 유형을 선택**하세요。  어떤 이모지 유형이든 텍스트를 **자동으로** 디코딩합니다。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih **jenis emoji** untuk mengekod teks kepada jujukan emoji yang unik.  Penyahsulitan teks daripada mana-mana jenis emoji berlaku **secara automatik**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer het **type emoji** om tekst te coderen in een unieke emojireeks.  Het decoderen van tekst vanuit elk emojitype gebeurt **automatisch**."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o **tipo de emoji** para codificar o texto em uma sequência exclusiva de emojis.  A decodificação do texto a partir de qualquer tipo de emoji acontece **automaticamente**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите **тип эмодзи**, чтобы закодировать текст в уникальную последовательность эмодзи.  Декодирование текста из любого типа эмодзи происходит **автоматически**."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj **typ av emoji** för att koda text till en unik emojisekvens.  Dekryptering från vilken emojityp som helst sker **automatiskt**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni benzersiz bir emoji dizisine kodlamak için **emoji türünü seçin**.  Herhangi bir emoji türünden metni çözme işlemi **otomatik** olarak gerçekleşir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть **тип емодзі**, щоб закодувати текст в унікальну послідовність емодзі.  Розшифрування тексту з будь-якого типу емодзі відбувається **автоматично**."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn **loại biểu tượng cảm xúc** để mã hóa văn bản thành chuỗi emoji độc đáo.  Việc giải mã văn bản từ bất kỳ loại emoji nào sẽ diễn ra **tự động**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择**表情符号类型**，将文本编码为独特的表情符号序列。  从任何表情符号类型解码文本都会**自动完成**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇**表情符號型別**，將文字編碼為獨特的表情符號序列。  從任何表情符號型別解碼文字都會**自動完成**。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg **typen emoji** for å kode tekst til en unik emojisekvens.  Dekoding av tekst fra enhver emojitype skjer **automatisk**."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz **rodzaj emoji**, aby zakodować tekst w unikalną sekwencję emoji.  Dekodowanie tekstu z dowolnego rodzaju emoji odbywa się **automatycznie**."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectează **tipul de emoji** pentru a codifica textul într-o secvență unică de emoji.  Decodarea textului din orice tip de emoji se face **automat**."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber **typ emoji**, ktorým zakóduješ text do jedinečnej sekvencie.  Dekódovanie textu z akéhokoľvek typu emoji prebieha **automaticky**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก **ประเภทอีโมจิ** เพื่อเข้ารหัสข้อความเป็นชุดอีโมจิที่ไม่ซ้ำกัน.  การถอดข้อความจากอีโมจิประเภทใดๆ จะเกิดขึ้น **โดยอัตโนมัติ**."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu **tegund emoji** til að kóða texta í einstaka emoji-röð.  Afkóðun texta úr hvaða emoji-tegund sem er fer fram **sjálfkrafa**."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mətni unikal emoji ardıcıllığına kodlaşdırmaq üçün **emoji növünü** seç.  İstənilən emoji növündən mətni dekodlaşdırmaq **avtomatik** aparılır."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք **emoji-ի տեսակը**, որպեսզի տեքստը կոդավորեք եզակի emoji-ների հաջորդականությամբ.  Տեքստի ապակոդավորումը ցանկացած emoji տեսակից կատարվում է **ավտոմատ**."
          }
        }
      }
    },
