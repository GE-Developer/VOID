    "Cryptography.AES-256.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "**En sortir d'aquesta pantalla, totes les dades (contrasenya, VOID, paràmetres Argon2id) es restabliran.  L'aplicació no emmagatzema dades a la memòria del telèfon.**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Po opuštění této obrazovky budou všechna data (heslo, VOID, parametry Argon2id) resetována.  Aplikace neukládá data do paměti telefonu.**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Når du forlader denne skærm, bliver alle data (adgangskode, VOID, Argon2id-parametre) nulstillet.  Appen gemmer ikke data i telefonens hukommelse.**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Wenn du diesen Bildschirm verlässt, werden alle Daten (Passwort, VOID, Argon2id-Parameter) zurückgesetzt.  Die App speichert keine Daten im Telefonspeicher.**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Μόλις φύγετε από αυτήν την οθόνη, όλα τα δεδομένα (κωδικός πρόσβασης, VOID, παράμετροι Argon2id) θα μηδενιστούν.  Η εφαρμογή δεν αποθηκεύει δεδομένα στη μνήμη του τηλεφώνου.**"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Upon leaving this screen, all data (password, VOID, Argon2id parameters) will be reset.  The application does not store data in the phone's memory.**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Al salir de esta pantalla, todos los datos (contraseña, VOID, parámetros de Argon2id) se restablecerán.  La aplicación no almacena datos en la memoria del teléfono.**"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kun poistut tältä näytöltä, kaikki tiedot (salasana, VOID, Argon2id-parametrit) nollautuvat.  Sovellus ei tallenna tietoja puhelimen muistiin.**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**En quittant cet écran, toutes les données (mot de passe, VOID, paramètres Argon2id) seront réinitialisées.  L'application ne conserve pas les données dans la mémoire du téléphone.**"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**इस स्क्रीन से बाहर निकलते ही सभी डेटा (पासवर्ड, VOID, Argon2id पैरामीटर) रीसेट हो जाएंगे।  एप्लिकेशन फोन की मेमोरी में कोई डेटा संग्रहीत नहीं करता।**"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Napustite li ovaj zaslon, svi podaci (lozinka, VOID, Argon2id parametri) bit će resetirani.  Aplikacija ne pohranjuje podatke u memoriji telefona.**"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ha elhagyod ezt a képernyőt, minden adat (jelszó, VOID, Argon2id paraméterek) visszaáll.  Az alkalmazás nem tárol adatokat a telefon memóriájában.**"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Saat meninggalkan layar ini, semua data (kata sandi, VOID, parameter Argon2id) akan disetel ulang.  Aplikasi tidak menyimpan data di memori ponsel.**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Quando lasci questa schermata, tutti i dati (password, VOID, parametri Argon2id) verranno reimpostati.  L'app non memorizza i dati nella memoria del telefono.**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**この画面を離れると、すべてのデータ（パスワード、VOID、Argon2id パラメータ）がリセットされます。  アプリはデータを端末のメモリに保存しません。**"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "**თუ ამ ეკრანს დატოვებთ, ყველა მონაცემი (პაროლი, VOID, Argon2id-ის პარამეტრები) განულდება.  აპლიკაცია არ ინახავს მონაცემებს ტელეფონის მეხსიერებაში.**"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**이 화면을 떠나면 모든 데이터(비밀번호, VOID, Argon2id 매개변수)가 초기화됩니다。  앱은 휴대전화 메모리에 데이터를 저장하지 않습니다。**"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**Apabila anda meninggalkan skrin ini, semua data (kata laluan, VOID, parameter Argon2id) akan ditetapkan semula.  Aplikasi tidak menyimpan data dalam memori telefon.**"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Wanneer je dit scherm verlaat, worden alle gegevens (wachtwoord, VOID, Argon2id-parameters) gereset.  De app slaat geen gegevens op in het geheugen van de telefoon.**"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ao sair desta tela, todos os dados (senha, VOID, parâmetros Argon2id) serão redefinidos.  O aplicativo não armazena dados na memória do telefone.**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**При покидании этого экрана все данные (пароль, VOID, параметры Argon2id) сбросятся.  Приложение не хранит данные в памяти телефона.**"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**När du lämnar den här skärmen återställs all data (lösenord, VOID, Argon2id-parametrar).  Appen lagrar inte data i telefonens minne.**"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bu ekrandan ayrıldığınızda tüm veriler (parola, VOID, Argon2id parametreleri) sıfırlanır.  Uygulama verileri telefonun belleğinde saklamaz.**"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**При виході з цього екрану всі дані (пароль, VOID, параметри Argon2id) скинуться.  Додаток не зберігає дані в пам'яті телефону.**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Khi rời khỏi màn hình này, toàn bộ dữ liệu (mật khẩu, VOID, tham số Argon2id) sẽ được đặt lại.  Ứng dụng không lưu dữ liệu trong bộ nhớ điện thoại.**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**离开此页面时，所有数据（密码、VOID、Argon2id 参数）都会被重置。  应用不会在手机内存中存储数据。**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**離開此頁面時，所有資料（密碼、VOID、Argon2id 引數）都會被重置。  應用不會在手機記憶體中儲存資料。**"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Når du forlater denne skjermen, tilbakestilles all data (passord, VOID, Argon2id-parametere).  Appen lagrer ikke data i telefonens minne.**"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Po opuszczeniu tego ekranu wszystkie dane (hasło, VOID, parametry Argon2id) zostaną zresetowane.  Aplikacja nie przechowuje danych w pamięci telefonu.**"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**De îndată ce părăsești acest ecran, toate datele (parolă, VOID, parametrii Argon2id) vor fi resetate.  Aplicația nu stochează date în memoria telefonului.**"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Po opustení tejto obrazovky sa všetky údaje (heslo, VOID, parametre Argon2id) vymažú.  Aplikácia neukladá údaje do pamäte telefónu.**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**เมื่อคุณออกจากหน้าจอนี้ ข้อมูลทั้งหมด (รหัสผ่าน, VOID, พารามิเตอร์ Argon2id) จะถูกรีเซ็ต.  แอปจะไม่เก็บข้อมูลไว้ในหน่วยความจำของโทรศัพท์.**"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Um leið og þú yfirgefur þennan skjá verða öll gögn (lykilorð, VOID, Argon2id-breytur) endurstillt.  Forritið geymir ekki gögn í minni símans.**"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bu ekrandan çıxan kimi bütün məlumatlar (şifrə, VOID, Argon2id parametrləri) sıfırlanacaq.  Tətbiq məlumatı telefonun yaddaşında saxlamır.**"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "**Այս էկրանից դուրս գալուն պես բոլոր տվյալները (գաղտնաբառը, VOID-ը, Argon2id-ի պարամետրերը) կմաքրվեն.  Հավելվածը սարքի հիշողության մեջ տվյալներ չի պահպանում.**"
          }
        }
      }
    },
