    "CryptoSettings.Parallelism.instructions %lld": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El teu dispositiu té **%lld nucli**. Augmentar el nombre de tasques en paral·lel pot **accelerar el xifratge**, però pot consumir més bateria."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El teu dispositiu té **%lld nuclis**. Augmentar el nombre de tasques en paral·lel pot **accelerar el xifratge**, però pot consumir més bateria."
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vaše zařízení má **%lld jádra**. Zvýšení počtu paralelních úloh může **zrychlit šifrování**, ale může spotřebovat více baterie."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vaše zařízení má **%lld jádro**. Zvýšení počtu paralelních úloh může **zrychlit šifrování**, ale může spotřebovat více baterie."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vaše zařízení má **%lld jader**. Zvýšení počtu paralelních úloh může **zrychlit šifrování**, ale může spotřebovat více baterie."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Din enhed har **%lld kerne**. At øge antallet af parallelle opgaver kan **fremskynde krypteringen**, men kan forbruge mere batteri."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Din enhed har **%lld kerner**. At øge antallet af parallelle opgaver kan **fremskynde krypteringen**, men kan forbruge mere batteri."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dein Gerät verfügt über **%lld Kern**. Eine höhere Anzahl paralleler Aufgaben kann die **Verschlüsselung beschleunigen**, verbraucht jedoch möglicherweise mehr Akku."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dein Gerät verfügt über **%lld Kerne**. Eine höhere Anzahl paralleler Aufgaben kann die **Verschlüsselung beschleunigen**, verbraucht jedoch möglicherweise mehr Akku."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Η συσκευή σας διαθέτει **%lld πυρήνα**. Η αύξηση του αριθμού παράλληλων εργασιών μπορεί να **επιταχύνει την κρυπτογράφηση**, αλλά ίσως καταναλώσει περισσότερη μπαταρία."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Η συσκευή σας διαθέτει **%lld πυρήνες**. Η αύξηση του αριθμού παράλληλων εργασιών μπορεί να **επιταχύνει την κρυπτογράφηση**, αλλά ίσως καταναλώσει περισσότερη μπαταρία."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your device has **%lld core**. Increasing the number of parallel tasks can **speed up encryption**, but may consume more battery."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your device has **%lld cores**.  Increasing the number of parallel tasks can **speed up encryption**, but may consume more battery."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu dispositivo tiene **%lld núcleo**.  \nAumentar el número de tareas paralelas puede **acelerar el cifrado**, pero puede consumir más batería."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu dispositivo tiene **%lld núcleos**.  \nAumentar el número de tareas paralelas puede **acelerar el cifrado**, pero puede consumir más batería."
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Laitteessasi on **%lld ydin**. Rinnakkaisten tehtävien määrän lisääminen voi **nopeuttaa salausta**, mutta voi kuluttaa enemmän akkua."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Laitteessasi on **%lld ydintä**. Rinnakkaisten tehtävien määrän lisääminen voi **nopeuttaa salausta**, mutta voi kuluttaa enemmän akkua."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Votre appareil a **%lld cœur**. Augmenter le nombre de tâches parallèles peut **accélérer le chiffrement**, mais peut consommer plus de batterie."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Votre appareil a **%lld cœurs**. Augmenter le nombre de tâches parallèles peut **accélérer le chiffrement**, mais peut consommer plus de batterie."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "आपके डिवाइस में **%lld कोर** है। समानांतर कार्यों की संख्या बढ़ाने से **एन्क्रिप्शन तेज** हो सकता है, लेकिन इससे बैटरी की खपत बढ़ सकती है।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "आपके डिवाइस में **%lld कोर** हैं। समानांतर कार्यों की संख्या बढ़ाने से **एन्क्रिप्शन तेज** हो सकता है, लेकिन इससे बैटरी की खपत बढ़ सकती है।"
                }
              }
            }
          }
        },
        "hr": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vaš uređaj ima **%lld jezgre**. Povećanje broja paralelnih zadataka može **ubrzati šifriranje**, ali može trošiti više baterije."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vaš uređaj ima **%lld jezgri**. Povećanje broja paralelnih zadataka može **ubrzati šifriranje**, ali može trošiti više baterije."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vaš uređaj ima **%lld jezgru**. Povećanje broja paralelnih zadataka može **ubrzati šifriranje**, ali može trošiti više baterije."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vaš uređaj ima **%lld jezgri**. Povećanje broja paralelnih zadataka može **ubrzati šifriranje**, ali može trošiti više baterije."
                }
              }
            }
          }
        },
        "hu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A készülékednek **%lld magja van**. A párhuzamos feladatok számának növelése **felgyorsíthatja a titkosítást**, de több akkumulátort fogyaszthat."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A készülékednek **%lld magja van**. A párhuzamos feladatok számának növelése **felgyorsíthatja a titkosítást**, de több akkumulátort fogyaszthat."
                }
              }
            }
          }
        },
        "id": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Perangkat Anda memiliki **%lld inti**. Meningkatkan jumlah tugas paralel dapat **mempercepat enkripsi**, tetapi mungkin menghabiskan lebih banyak baterai."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Perangkat Anda memiliki **%lld inti**. Meningkatkan jumlah tugas paralel dapat **mempercepat enkripsi**, tetapi mungkin menghabiskan lebih banyak baterai."
                }
