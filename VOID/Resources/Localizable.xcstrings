            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il tuo dispositivo ha **%lld core**. Aumentare il numero di attività parallele può **accelerare la cifratura**, ma può consumare più batteria."
                }
              },
              "other": {
                "stringUnit": {
