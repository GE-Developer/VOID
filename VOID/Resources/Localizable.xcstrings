    "Home.Encoding.description": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar el format de les dades sense ocultar la informació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna formátu dat bez skrytí informací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændrer dataformatet uden at skjule informationen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern des Datenformats, ohne die Informationen zu verbergen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλαγή του μορφότυπου των δεδομένων χωρίς απόκρυψη των πληροφοριών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the data format without concealing the information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el formato de los datos sin ocultar la información."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Datan muodon muuttaminen ilman tiedon piilottamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier le format des données sans dissimuler les informations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जानकारी को छिपाए बिना डेटा प्रारूप को बदलना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena formata podataka bez skrivanja informacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatok formátumának módosítása az információ elrejtése nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah format data tanpa menyembunyikan informasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificare il formato dei dati senza nascondere le informazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報を隠さずにデータ形式を変更します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ფორმატის შეცვლა ინფორმაციის დამალვის გარეშე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보를 숨기지 않고 데이터 형식을 변경합니다。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar format data tanpa menyembunyikan maklumat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gegevensformaat wijzigen zonder de informatie te verbergen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o formato dos dados sem ocultar as informações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена формата данных без скрытия информации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra dataformatet utan att dölja informationen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgiyi gizlemeden veri biçimini değiştirme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінення формату даних без приховування інформації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi định dạng dữ liệu mà không che giấu thông tin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
