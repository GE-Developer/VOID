        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İterasiyalar"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իտերացիաներ"
          }
        }
      }
    },
    "CryptoSettings.KeyLength.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La **longitud de la clau** determina com de difícil és forçar les teves dades — com **més llarga** sigui la clau, **més forta** és la protecció. Els valors més alts incrementen la seguretat però poden alentir una mica el processament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Délka klíče** určuje, jak obtížné je vaše data prolomit hrubou silou — čím je klíč **delší**, tím je ochrana **silnější**. Vyšší hodnoty zvyšují bezpečnost, ale mohou mírně zpomalit zpracování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nøglens længde** bestemmer, hvor svært det er at brute-force dine data — jo **længere** nøglen er, desto **stærkere** er beskyttelsen. Højere værdier øger sikkerheden, men kan gøre behandlingen en smule langsommere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die **Schlüssellänge** bestimmt, wie schwer es ist, deine Daten per Brute Force zu knacken — je **länger** der Schlüssel, desto **stärker** der Schutz. Höhere Werte erhöhen die Sicherheit, können die Verarbeitung jedoch leicht verlangsamen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το **μήκος του κλειδιού** καθορίζει πόσο δύσκολο είναι να γίνει brute force στα δεδομένα σας — όσο **μεγαλύτερο** το κλειδί, τόσο **ισχυρότερη** η προστασία. Μεγαλύτερες τιμές αυξάνουν την ασφάλεια αλλά μπορεί να επιβραδύνουν ελαφρώς την επεξεργασία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Key length** defines how hard it is to brute-force your data — the **longer** the key, the **stronger** the protection. Higher values increase security but may slightly slow down processing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La **longitud de la clave** define lo difícil que es forzar tus datos mediante fuerza bruta — cuanto **más larga** es la clave, **mayor** es la protección.  \nValores más altos aumentan la seguridad, pero pueden ralentizar ligeramente el procesamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Avaimen pituus** määrittää, kuinka vaikeaa tietosi on murtaa brute forcella — mitä **pidempi** avain on, sitä **vahvempi** suoja. Suuremmat arvot lisäävät turvallisuutta, mutta voivat hieman hidastaa käsittelyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La **longueur de la clé** détermine la difficulté de forcer les données. Plus la clé est **longue**, plus la protection est **forte**. Des valeurs plus élevées augmentent la sécurité mais peuvent légèrement ralentir le traitement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**कुंजी की लंबाई** तय करती है कि आपके डेटा पर बलपूर्वक हमला करना कितना कठिन होगा — कुंजी जितनी **लंबी**, सुरक्षा उतनी **मजबूत**। उच्च मान सुरक्षा बढ़ाते हैं लेकिन प्रोसेसिंग को थोड़ा धीमा कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Duljina ključa** određuje koliko je teško na silu doći do vaših podataka — što je ključ **dulji**, to je zaštita **jača**. Više vrijednosti povećavaju sigurnost, ali mogu malo usporiti obradu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A **kulcshossz** határozza meg, mennyire nehéz brute force-szal feltörni az adataidat — minél **hosszabb** a kulcs, annál **erősebb** a védelem. A magasabb értékek növelik a biztonságot, de kissé lassíthatják a feldolgozást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Panjang kunci** menentukan seberapa sulit data Anda dibobol dengan brute force — semakin **panjang** kuncinya, semakin **kuat** perlindungannya. Nilai yang lebih tinggi meningkatkan keamanan namun dapat sedikit memperlambat pemrosesan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La **lunghezza della chiave** determina quanto è difficile forzare i dati. Più la chiave è **lunga**, più la protezione è **forte**. Valori più alti aumentano la sicurezza ma possono rallentare leggermente l'elaborazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**鍵の長さ**はデータを総当たり攻撃で解読する難しさを決定します — 鍵が**長い**ほど保護は**強く**なります。 値が大きいほどセキュリティは向上しますが、処理がわずかに遅くなる場合があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "**გასაღები კოდის სიგრძე** განსაზღვრავს რამდენად რთულია თქვენი მონაცემების ბრუტფორსი — რაც **მეტია სიგრძე**, მით **მტკიცეა დაცვა**. მაღალი მნიშვნელობები ზრდის უსაფრთხოებას, თუმცა შესაძლოა ცოტა შეანელოს პროცესირება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**키 길이**는 데이터를 무차별 대입으로 뚫기 어려운 정도를 결정합니다 — 키가 **길수록** 보호가 **강해집니다**。 값이 높을수록 보안은 증가하지만 처리 속도가 약간 느려질 수 있습니다。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**Panjang kunci** menentukan betapa sukarnya data anda dipecahkan secara brute force — semakin **panjang** kunci, semakin **kukuh** perlindungan. Nilai yang lebih tinggi meningkatkan keselamatan tetapi boleh sedikit memperlahankan pemprosesan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De **sleutellengte** bepaalt hoe moeilijk het is om je gegevens met brute force te kraken — hoe **langer** de sleutel, hoe **sterker** de bescherming. Hogere waarden vergroten de veiligheid maar kunnen de verwerking iets vertragen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**O comprimento da chave** define o quão difícil é quebrar seus dados por força bruta — quanto mais **longa** a chave, mais **forte** a proteção. Valores maiores aumentam a segurança, mas podem deixar o processamento um pouco mais lento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Длина ключа** определяет, насколько сложно взломать ваши данные перебором — чем **длиннее** ключ, тем **выше защита**. Большие значения повышают безопасность, но могут немного замедлить обработку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nyckellängden** avgör hur svårt det är att knäcka dina data genom brute force — ju **längre** nyckeln är, desto **starkare** skydd. Högre värden ökar säkerheten men kan göra bearbetningen något långsammare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Anahtar uzunluğu**, verilerinizin brute force ile kırılmasının zorluğunu belirler — anahtar ne kadar **uzunsa**, koruma o kadar **güçlüdür**. Daha yüksek değerler güvenliği artırır ancak işlemi biraz yavaşlatabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Довжина ключа** означає, наскільки складно підібрати ваші дані методом brute-force — чим **довший** ключ, тим **сильніший** захист. Вищі значення підвищують безпеку, але можуть трохи сповільнити обробку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Độ dài khóa** quyết định mức độ khó khi bị brute-force — khóa càng **dài**, bảo vệ càng **mạnh**. Giá trị cao hơn giúp tăng bảo mật nhưng có thể làm chậm xử lý đôi chút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**密钥长度**决定了数据被暴力破解的难度 — 密钥越**长**，防护越**强**。 更高的数值可提升安全性，但可能会略微降低处理速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**金鑰長度**決定了資料被暴力破解的難度——金鑰越**長**，防護越**強**。 更高的數值可提升安全性，但可能會略微降低處理速度。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nøkkellengden** bestemmer hvor vanskelig det er å brute-force dataene dine — jo **lengre** nøkkelen er, desto **sterkere** er beskyttelsen. Høyere verdier øker sikkerheten, men kan gjøre behandlingen litt tregere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Długość klucza** określa, jak trudno jest złamać dane metodą brute force — im **dłuższy** klucz, tym **silniejsza** ochrona. Wyższe wartości zwiększają bezpieczeństwo, lecz mogą nieznacznie spowolnić przetwarzanie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**Lungimea cheii** determină cât de greu este să-ți fie sparte datele prin forță brută — cu cât cheia este **mai lungă**, cu atât protecția este **mai puternică**. Valorile mai mari cresc securitatea, dar pot încetini ușor procesarea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dĺžka kľúča** určuje, ako ťažké je prelomiť tvoje dáta hrubou silou — čím je kľúč **dlhší**, tým je ochrana **silnejšia**. Vyššie hodnoty zvyšujú bezpečnosť, ale môžu mierne spomaliť spracovanie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ความยาวของคีย์** กำหนดว่าการบังคับถอดข้อมูลของคุณยากเพียงใด — ยิ่งคีย์ **ยาว** การป้องกันก็ยิ่ง **แข็งแรง**. ค่าที่สูงขึ้นเพิ่มความปลอดภัย แต่สามารถทำให้การประมวลผลช้าลงเล็กน้อย."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Lengd lykils** ákvarðar hversu erfitt er að brjóta gögnin þín með brute force — því **lengri** sem lykillinn er, því **sterkari** er verndin. Hærri gildi auka öryggi en geta aðeins hægt á vinnslu."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**Açarın uzunluğu** məlumatların güc tətbiqi ilə sındırılmasını nə qədər çətinləşdirəcəyini müəyyən edir — açar nə qədər **uzundursa**, mühafizə bir o qədər **güclüdür**. Yüksək dəyərlər təhlükəsizliyi artırır, amma işlənməni cüzi ləngidə bilər."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "**Բանալու երկարությունը** որոշում է, թե որքան բարդ կլինի տվյալները կոտրել ուժի կիրառմամբ — որքան **երկար է բանալին**, այնքան **ուժեղ է պաշտպանությունը**. Բարձր արժեքները բարձրացնում են անվտանգությունը, սակայն կարող են մի փոքր դանդաղեցնել մշակումը."
          }
        }
      }
    },
