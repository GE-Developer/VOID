          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdelijke bestanden, caches en documentbestanden worden verwijderd. App-instellingen blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaną usunięte pliki tymczasowe, pamięć podręczna i dokumenty. Ustawienia aplikacji zostaną zachowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serão removidos ficheiros temporários, caches e documentos. As definições da aplicação serão mantidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor fi eliminate fișierele temporare, memoria cache și documentele. Setările aplicației vor fi păstrate."
