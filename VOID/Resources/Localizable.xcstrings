    "FullScreenAnimation.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén l'app oberta fins que el procés es completi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte aplikaci otevřenou, dokud se proces nedokončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold appen åben, indtil processen er fuldført."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lass die App geöffnet, bis der Vorgang abgeschlossen ist."
          }
        },
