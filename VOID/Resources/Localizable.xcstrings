    "EmojiCoding.headerText": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Codificar text en emojis és una **representació visual de les dades**, similar a Base64.  **No ofereix protecció criptogràfica**.  Es pot combinar amb xifratge per aconseguir més seguretat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kódování textu do emoji je **vizuální reprezentace dat**, podobně jako Base64.  **Neposkytuje kryptografickou ochranu**.  Lze jej kombinovat se šifrováním pro vyšší bezpečnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At kode tekst til emojis er en **visuel repræsentation af data**, ligesom Base64.  **Det giver ingen kryptografisk beskyttelse**.  Det kan kombineres med kryptering for at øge sikkerheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text in Emojis zu codieren ist eine **visuelle Darstellung von Daten**, ähnlich wie Base64.  **Es bietet keinen kryptografischen Schutz**.  Es kann mit Verschlüsselung kombiniert werden, um die Sicherheit zu erhöhen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κωδικοποίηση κειμένου σε emoji είναι μια **οπτική αναπαράσταση δεδομένων**, παρόμοια με το Base64.  **Δεν παρέχει κρυπτογραφική προστασία**.  Μπορεί να συνδυαστεί με κρυπτογράφηση για μεγαλύτερη ασφάλεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoding text into emojis is a **visual representation of data**, similar to Base64.  **It does not provide cryptographic protection**.  It can be combined with encryption for stronger security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Codificar texto en emojis es una **representación visual de datos**, similar a Base64.  **No proporciona protección criptográfica**.  Se puede combinar con cifrado para mayor seguridad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstin koodaaminen emojeiksi on **datan visuaalinen esitys**, kuten Base64.  **Se ei tarjoa kryptografista suojaa**.  Sen voi yhdistää salaukseen paremman turvallisuuden saavuttamiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoder du texte en emojis est une **représentation visuelle des données**, similaire à Base64.  **Cela ne fournit pas de protection cryptographique**.  Il peut être combiné avec le chiffrement pour une sécurité renforcée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट को इमोजी में एन्कोड करना **डेटा का दृश्य प्रतिनिधित्व** है, Base64 के समान।  **यह क्रिप्टोग्राफिक सुरक्षा प्रदान नहीं करता**।  इसे मजबूत सुरक्षा के लिए एन्क्रिप्शन के साथ जोड़ा जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodiranje teksta u emodžije je **vizualno predstavljanje podataka**, slično Base64.  **Ne pruža kriptografsku zaštitu**.  Može se kombinirati sa šifriranjem za jaču sigurnost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveg emoji-vá alakítása **vizuális adatábrázolás**, hasonlóan a Base64-hez.  **Nem nyújt kriptográfiai védelmet**.  Titkosítással kombinálva nagyobb biztonságot adhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengodekan teks menjadi emoji adalah **representasi visual data**, mirip dengan Base64.  **Ini tidak memberikan perlindungan kriptografis**.  Dapat dikombinasikan dengan enkripsi untuk keamanan yang lebih kuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codificare il testo in emoji è una **rappresentazione visiva dei dati**, simile a Base64.  **Non fornisce protezione crittografica**.  Può essere combinato con la crittografia per una maggiore sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを絵文字にエンコードすることは、Base64と同様に**データを視覚的に表現する方法**です。  **これは暗号化による保護を提供しません**。  より強力なセキュリティのために暗号化と組み合わせることができます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტექსტის ემოჯებად კოდირება **მონაცემთა ვიზუალური წარმოდგენაა**, Base64-ის მსგავსი.   **ის არ უზრუნველყოფს კრიპტოგრაფიულ დაცვას**.  შეიძლება გაერთიანდეს შიფრაციასთან უფრო ძლიერი უსაფრთხოებისთვის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 이모지로 인코딩하는 것은 Base64와 유사한 **데이터의 시각적 표현**입니다。  **암호화 보호를 제공하지 않습니다**。  더 강력한 보안을 위해 암호화와 결합할 수 있습니다。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukarkan teks kepada emoji ialah **representasi visual data**, seakan-akan Base64.  **Ia tidak menyediakan perlindungan kriptografi**.  Boleh digabungkan dengan penyulitan untuk keselamatan yang lebih kukuh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst coderen naar emoji is een **visuele representatie van gegevens**, vergelijkbaar met Base64.  **Het biedt geen cryptografische bescherming**.  Het kan worden gecombineerd met encryptie voor sterkere beveiliging."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Codificar texto em emojis é uma **representação visual de dados**, semelhante ao Base64.  **Não fornece proteção criptográfica**.  Pode ser combinado com criptografia para maior segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодирование текста в эмоджи — **визуальное представление данных**, подобное Base64.  **Не обеспечивает криптографической защиты**.  Может использоваться совместно с шифрованием для повышения криптостойкости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att koda text till emojis är en **visuell representation av data**, liknande Base64.  **Det ger inget kryptografiskt skydd**.  Det kan kombineras med kryptering för starkare säkerhet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni emojilere kodlamak, Base64'e benzer şekilde **verilerin görsel temsili**dir.  **Kriptografik koruma sağlamaz**.  Daha güçlü güvenlik için şifreleme ile birleştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодування тексту у емодзі — це **візуальне подання даних**, подібне до Base64.  **Це не забезпечує криптографічного захисту**.  Може бути поєднано з шифруванням для більшої безпеки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã hóa văn bản thành emoji là **một phương pháp biểu diễn dữ liệu trực quan**, tương tự như Base64.  **Nó không cung cấp bảo vệ mật mã**.  Có thể kết hợp với mã hóa để tăng cường bảo mật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文本编码为表情符号是一种**数据的可视化表示方式**，类似于 Base64。  **它不提供加密保护**。  可以与加密结合使用以增强安全性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將文本編碼為表情符號是一種**數據的可視化表示方式**，類似於 Base64。  **它不提供加密保護**。  可以與加密結合使用以增強安全性。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å kode tekst til emoji er en **visuell representasjon av data**, lik Base64.  **Det gir ingen kryptografisk beskyttelse**.  Det kan kombineres med kryptering for sterkere sikkerhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodowanie tekstu na emoji to **wizualna reprezentacja danych**, podobna do Base64.  **Nie zapewnia ochrony kryptograficznej**.  Można połączyć je z szyfrowaniem, aby zwiększyć bezpieczeństwo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codificarea textului în emoji este o **reprezentare vizuală a datelor**, similară cu Base64.  **Nu oferă protecție criptografică**.  Poate fi combinată cu criptarea pentru o securitate mai ridicată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kódovanie textu do emoji je **vizuálne zobrazenie dát**, podobné Base64.  **Neposkytuje kryptografickú ochranu**.  Možno ho skombinovať so šifrovaním pre vyššiu bezpečnosť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้ารหัสข้อความเป็นอีโมจิเป็น **การนำเสนอข้อมูลเชิงภาพ** คล้ายกับ Base64.  **มันไม่ให้การป้องกันเชิงคริปโต**.  สามารถใช้ร่วมกับการเข้ารหัสเพื่อเพิ่มความปลอดภัยได้."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Að kóða texta í emoji er **sjónræn framsetning gagna**, svipuð Base64.  **Það veitir enga kryptógrafíska vernd**.  Hægt er að sameina hana við dulkóðun til meiri öryggis."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mətni emoji-lərə kodlaşdırmaq **məlumatın vizual təqdimatıdır**, Base64-ə bənzəyir.  **Kriptoqrafik mühafizə təmin etmir**.  Daha güclü qorunma üçün şifrələmə ilə birlikdə istifadə oluna bilər."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեքստը emoji-ների մեջ կոդավորելը **տվյալների տեսողական ներկայացում է**, նման Base64-ին.  **Կրիպտոգրաֆիկ պաշտպանություն չի ապահովում**.  Ավելի հուսալի պաշտպանության համար այն կարող եք համատեղել կոդավորման հետ."
          }
        }
      }
    },
