    "CryptoSettings.Security.Void.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID reforça la clau criptogràfica** afegint un component intern ocult.  Un valor de 0 significa que el xifrat es fa sense VOID.  **El número VOID només afecta la selecció de la variant**, no el nivell de protecció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID posiluje kryptografický klíč** přidáním skryté vnitřní součásti.  Hodnota 0 znamená, že šifrování probíhá bez VOIDu.  **Číslo VOID ovlivňuje pouze výběr varianty**, nikoli úroveň ochrany."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID styrker den kryptografiske nøgle** ved at tilføje en skjult intern komponent.  0 betyder, at kryptering udføres uden VOID.  **VOID-nummeret påvirker kun valg af variant**, ikke beskyttelsesniveauet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID verstärkt den kryptografischen Schlüssel**, indem es eine versteckte interne Komponente hinzufügt.  Der Wert 0 bedeutet, dass ohne VOID verschlüsselt wird.  **Die VOID-Nummer beeinflusst nur die Variantenwahl**, nicht das Schutzniveau."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το **VOID ενισχύει το κρυπτογραφικό κλειδί** προσθέτοντας ένα κρυφό εσωτερικό στοιχείο.  0 σημαίνει ότι η κρυπτογράφηση γίνεται χωρίς VOID.  **Ο αριθμός VOID επηρεάζει μόνο την επιλογή παραλλαγής**, όχι το επίπεδο προστασίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID enhances the cryptographic key** by adding a hidden internal component.  A value of 0 means encryption is performed without VOID.  **The VOID number only affects the variant selection**, not the level of protection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID refuerza la clave criptográfica** al añadir un componente interno oculto.  Un valor de 0 significa que el cifrado se realiza sin VOID.  **El número de VOID solo afecta a la selección de la variante**, no al nivel de protección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID vahvistaa kryptografista avainta** lisäämällä piilotetun sisäisen komponentin.  0 tarkoittaa, että salaus tehdään ilman VOIDia.  **VOID-numero vaikuttaa vain variantin valintaan**, ei suojauksen tasoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID renforce la clé cryptographique** en ajoutant une composante interne cachée.  Une valeur de 0 signifie que le chiffrement est effectué sans VOID.  **Le numéro VOID influence uniquement le choix de la variante**, et non le niveau de protection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID एक छिपा हुआ आंतरिक घटक जोड़कर क्रिप्टोग्राफ़िक कुंजी को बढ़ाता है।  मान 0 होने पर एन्क्रिप्शन VOID के बिना किया जाता है।  VOID संख्या केवल वेरिएंट चयन को प्रभावित करती है, सुरक्षा के स्तर को नहीं।**"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID pojačava kriptografski ključ** dodavanjem skrivenog internog elementa.  Vrijednost 0 znači da se šifriranje izvodi bez VOID-a.  **Broj VOID utječe samo na odabir varijante**, ne na razinu zaštite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A **VOID megerősíti a kriptográfiai kulcsot** egy rejtett belső komponens hozzáadásával.  0 érték esetén a titkosítás VOID nélkül történik.  **A VOID szám csak a variáns kiválasztását befolyásolja**, a védelem szintjét nem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID memperkuat kunci kriptografis** dengan menambahkan komponen internal tersembunyi.  0 berarti enkripsi dilakukan tanpa VOID.  **Angka VOID hanya memengaruhi pemilihan varian**, bukan tingkat perlindungan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID rafforza la chiave crittografica** aggiungendo una componente interna nascosta.  Un valore pari a 0 significa che la cifratura viene eseguita senza VOID.  **Il numero VOID influisce solo sulla scelta della variante**, non sul livello di protezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID は隠された内部コンポーネントを加えることで暗号鍵を強化**します。  0 の値は、VOID なしで暗号化が行われることを意味します。  **VOID の数値はバリアントの選択にのみ影響し**、保護レベルは変わりません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID აძლიერებს კრიპტოგრაფიულ გასაღებ კოდს**, რადგან მას დამატებით დამალულ შიდა კომპონენტს უმატებს.  0 ნიშნავს, რომ შიფრაცია VOID-ის გარეშე სრულდება.  **VOID-ის ნომერი მხოლოდ ვარიანტის არჩევას განსაზღვრავს** და არა დაცვის დონეს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID는 숨겨진 내부 구성 요소를 추가하여 암호 키를 강화**합니다。  값이 0이면 VOID 없이 암호화를 수행함을 의미합니다。  **VOID 번호는 변형 선택에만 영향을 미치며**, 보호 수준은 바꾸지 않습니다。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID mengukuhkan kunci kriptografi** dengan menambah komponen dalaman tersembunyi.  0 bermakna penyulitan dilakukan tanpa VOID.  **Nombor VOID hanya mempengaruhi pemilihan varian**, bukan tahap perlindungan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID versterkt de cryptografische sleutel** door een verborgen interne component toe te voegen.  Een waarde van 0 betekent dat er wordt versleuteld zonder VOID.  **Het VOID-nummer beïnvloedt alleen de variantkeuze**, niet het beschermingsniveau."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**O VOID reforça a chave criptográfica** adicionando um componente interno oculto.  Um valor 0 significa que a criptografia é realizada sem VOID.  **O número do VOID apenas afeta a escolha da variante**, não o nível de proteção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID усиливает криптографический ключ**, добавляя к нему скрытый внутренний компонент.  Значение 0 означает, что шифрование выполняется без VOID.  **Номер VOID влияет только на выбор варианта**, но не изменяет уровень защиты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID förstärker den kryptografiska nyckeln** genom att lägga till en dold intern komponent.  Värdet 0 betyder att krypteringen utförs utan VOID.  **VOID-numret påverkar bara variantvalet**, inte skyddsnivån."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID, gizli bir iç bileşen ekleyerek kriptografik anahtarı güçlendirir**.  Değer 0 ise şifreleme VOID olmadan gerçekleştirilir.  **VOID sayısı sadece varyant seçimini etkiler**, korunma seviyesini değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID посилює криптографічний ключ**, додаючи прихований внутрішній компонент.  0 означає, що шифрування виконується без VOID.  **Номер VOID впливає лише на вибір варіанта**, а не на рівень захисту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID tăng cường khóa mật mã** bằng cách thêm thành phần nội bộ ẩn.  Giá trị 0 có nghĩa là mã hóa được thực hiện mà không có VOID.  **Số VOID chỉ ảnh hưởng đến việc chọn biến thể**, không thay đổi mức bảo vệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID 通过加入隐藏的内部组件来增强密钥**。  当数值为 0 时，表示在没有 VOID 的情况下进行加密。  **VOID 数字只影响变体选择**，不会改变防护等级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID 透過加入隱藏的內部元件來增強金鑰**。  當數值為 0 時，表示在沒有 VOID 的情況下進行加密。  **VOID 數字隻影響變體選擇**，不會改變防護等級。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID forsterker den kryptografiske nøkkelen** ved å legge til en skjult intern komponent.  0 betyr at kryptering utføres uten VOID.  **VOID-nummeret påvirker kun valg av variant**, ikke sikkerhetsnivået."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID wzmacnia klucz kryptograficzny** poprzez dodanie ukrytego wewnętrznego komponentu.  0 oznacza, że szyfrowanie odbywa się bez VOID.  **Numer VOID wpływa jedynie na wybór wariantu**, nie na poziom ochrony."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID întărește cheia criptografică** adăugând o componentă internă ascunsă.  0 înseamnă că criptarea se face fără VOID.  **Numărul VOID influențează doar alegerea variantei**, nu și nivelul de protecție."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID posilňuje kryptografický kľúč** pridaním skrytej internej zložky.  0 znamená, že šifrovanie prebieha bez VOID-u.  **Číslo VOID ovplyvňuje iba výber variantu**, nie úroveň ochrany."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID ช่วยเสริมความแข็งแรงให้คีย์เข้ารหัส** ด้วยการเพิ่มส่วนประกอบภายในที่ซ่อนอยู่.  0 หมายถึงการเข้ารหัสจะดำเนินการโดยไม่มี VOID.  **ตัวเลข VOID มีผลเพียงการเลือกรูปแบบ** ไม่ได้เพิ่มระดับการป้องกัน."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID styrkir kryptógrafískan lykil** með því að bæta við falinni innri einingu.  0 þýðir að dulkóðun fer fram án VOID.  **VOID-númerið hefur aðeins áhrif á val á afbrigði**, ekki á verndarstig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID gizli daxili komponent əlavə etməklə kriptoqrafik açarı gücləndirir.**  0 dəyəri şifrələmənin VOID olmadan aparıldığını göstərir.  **VOID nömrəsi yalnız variant seçiminə təsir edir**, qoruma səviyyəsinə yox."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "**VOID-ը գաղտնաբառին ավելացնում է ներքին գաղտնի բաղադրիչ և ուժեղացնում է կրիպտոգրաֆիկ բանալին.** 0 արժեքը նշանակում է, որ կոդավորումը կատարվում է առանց VOID-ի.  **VOID-ի համար ընտրված թիվը ազդում է միայն տարբերակի վրա**, ոչ թե պաշտպանության մակարդակի."
          }
        }
      }
    },
