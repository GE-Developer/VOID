    "Settings.Customization.Style.headerTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعل الواجهة **خاصتك** حقاً. اختر لون تمييز يناسب أسلوبك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnterfeysi **həqiqətən özünüzə məxsus** edin. Öz stilinizə uyğun vurğu rəngi seçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зрабіце інтэрфейс сапраўды **вашым**. Выберыце акцэнтны колер, які пасуе вашаму стылю."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারফেসকে সত্যিকারের **আপনার** করে তুলুন। আপনার স্টাইলের সাথে মানানসই একটি অ্যাকসেন্ট রঙ নির্বাচন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes que la interfície sigui **realment teva**. Tria un color d'accent que s'adapti al teu estil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udělejte rozhraní skutečně **svým**. Vyberte barvu zvýraznění, která odpovídá vašemu stylu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør grænsefladen **helt til din egen**. Vælg en accentfarve, der passer til din stil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach die Oberfläche wirklich **zu deiner**. Wähle eine Akzentfarbe, die zu deinem Stil passt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε τη διεπαφή **πραγματικά δική σας**. Επιλέξτε ένα χρώμα έμφασης που ταιριάζει στο στυλ σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make the interface truly **yours**. Select an accent color that fits your style."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz que la interfaz sea **realmente tuya**. Elige un color de énfasis que se adapte a tu estilo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee käyttöliittymästä **aidosti omasi**. Valitse korostusväri, joka sopii tyyliisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites de l'interface quelque chose de **vraiment à vous**. Choisissez une couleur d'accent qui correspond à votre style."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפוך את הממשק **שלך** באמת. בחר צבע הדגשה שמתאים לסגנון שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरफ़ेस को **वास्तव में अपना** बनाएँ। अपनी शैली के अनुसार एक एक्सेंट रंग चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neka sučelje bude **stvarno tvoje**. Odaberi naglasnu boju koja odgovara tvom stilu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tedd az felületet igazán **a tiéddé**. Válassz egy hangsúlyszínt, amely illik a stílusodhoz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դարձրու ինտերֆեյսն **իսկապես քոնը**։ Ընտրիր շեշտադրված գույն, որը համապատասխանում է քո ոճին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadikan antarmuka **benar-benar milikmu**. Pilih warna aksen yang sesuai dengan gayamu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerðu viðmótið **sannarlega þitt**. Veldu áherslulitu sem passar við stíl þinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendi l'interfaccia **davvero tua**. Scegli un colore principale che rispecchi il tuo stile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターフェースを**本当に自分らしく**しましょう。 スタイルに合ったアクセントカラーを選択してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გახადე ინტერფეისი **ნამდვილად შენი**. აირჩიე აქცენტური ფერი, რომელიც შენს სტილს შეესაბამება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интерфейсті шынымен **өзіңіздікіне** айналдырыңыз. Стиліңізге сәйкес екпін түсін таңдаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터페이스를 **진정한 나만의 것**으로 만드세요. 나의 스타일에 맞는 강조 색상을 선택하세요."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интерфейсти чын эле **өзүңүздүкүнө** айландырыңыз. Стилиңизге ылайыктуу акцент түсүн тандаңыз."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadikan antara muka **benar-benar milik anda**. Pilih warna aksen yang sesuai dengan gaya anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør grensesnittet **virkelig ditt**. Velg en aksentfarge som passer din stil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak de interface echt **van jou**. Kies een accentkleur die bij jouw stijl past."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spraw, by interfejs był **naprawdę Twój**. Wybierz kolor akcentu pasujący do Twojego stylu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torne a interface **verdadeiramente sua**. Escolha uma cor de destaque que corresponda ao seu estilo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faceți interfața **cu adevărat a dvs.**. Alegeți o culoare de accent care se potrivește stilului dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделай интерфейс по-настоящему **своим**. Выбери акцентный цвет, который подходит именно тебе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urobte rozhranie skutočne **svojím**. Vyberte farbu zvýraznenia, ktorá zodpovedá vášmu štýlu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör gränssnittet **verkligt ditt**. Välj en accentfärg som passar din stil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้อินเตอร์เฟซ **เป็นของคุณอย่างแท้จริง** เลือกสีเน้นที่เข้ากับสไตล์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arayüzü **gerçekten kendinize özgü** yapın. Stilinize uyan bir vurgu rengi seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зробіть інтерфейс **справді своїм**. Оберіть акцентний колір, що відповідає вашому стилю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm cho giao diện **thực sự là của bạn**. Chọn màu nhấn phù hợp với phong cách của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让界面**真正属于你**。选择一个符合你风格的强调色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓介面**真正屬於你**。選擇一個符合你風格的強調色。"
          }
        }
      }
    },
