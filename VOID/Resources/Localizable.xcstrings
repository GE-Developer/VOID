    "AboutEmoji.howDoesItWorkDescription": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El text primer es converteix a UTF-8, després s'encoda en Base64 i, finalment, cada caràcter se substitueix per l'emoji corresponent.  Aquest algoritme **admet qualsevol caràcter i idioma**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text se nejprve převede do UTF-8, poté se zakóduje do Base64 a následně se každý znak nahradí odpovídajícím emojim.  Tento algoritmus **podporuje jakékoli znaky i jazyky**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten konverteres først til UTF-8, derefter kodes den i Base64, hvorefter hvert tegn erstattes med den tilsvarende emoji.  Denne algoritme **understøtter alle tegn og sprog**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text wird zuerst in UTF-8 konvertiert, dann in Base64 codiert, danach wird jedes Zeichen durch ein entsprechendes Emoji ersetzt.  Dieser Algorithmus **unterstützt alle Zeichen und Sprachen**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο μετατρέπεται πρώτα σε UTF-8, έπειτα κωδικοποιείται σε Base64 και στη συνέχεια κάθε χαρακτήρας αντικαθίσταται από το αντίστοιχο emoji.  Αυτός ο αλγόριθμος **υποστηρίζει οποιονδήποτε χαρακτήρα και γλώσσα**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is first converted to UTF-8, then encoded in Base64, after which each character is replaced with a corresponding emoji.  This algorithm **supports any characters and languages**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se convierte primero a UTF-8, luego se codifica en Base64, después de lo cual cada carácter se reemplaza por un emoji correspondiente.  Este algoritmo **admite cualquier carácter y lenguaje**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti muunnetaan ensin UTF-8-muotoon, sitten koodataan Base64:ään, minkä jälkeen jokainen merkki korvataan vastaavalla emojilla.  Tämä algoritmi **tukee kaikkia merkkejä ja kieliä**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte est d'abord converti en UTF-8, puis codé en Base64, après quoi chaque caractère est remplacé par un emoji correspondant.  Cet algorithme **prend en charge tous les caractères et toutes les langues**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठ को पहले UTF-8 में परिवर्तित किया जाता है, फिर Base64 में एन्कोड किया जाता है, इसके बाद प्रत्येक अक्षर को एक संबंधित इमोजी से बदल दिया जाता है।  यह एल्गोरिदम **किसी भी अक्षर और भाषा का समर्थन करता है**।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst se najprije pretvara u UTF-8, zatim se kodira u Base64, nakon čega se svaki znak zamjenjuje odgovarajućim emojijem.  Ovaj algoritam **podržava sve znakove i jezike**."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveget először UTF-8 formátumba konvertáljuk, majd Base64-be kódoljuk, ezután minden karaktert a megfelelő emojival helyettesítünk.  Ez az algoritmus **bármilyen karaktert és nyelvet támogat**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks terlebih dahulu dikonversi ke UTF-8, lalu dikodekan ke Base64, setelah itu setiap karakter diganti dengan emoji yang sesuai.  Algoritme ini **mendukung karakter dan bahasa apa pun**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo viene prima convertito in UTF-8, quindi codificato in Base64, dopo di che ogni carattere viene sostituito con un'emoji corrispondente.  Questo algoritmo **supporta tutti i caratteri e le lingue**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストは最初に UTF-8 に変換され、その後 Base64 にエンコードされ、各文字が対応する絵文字に置き換えられます。  このアルゴリズムは**すべての文字と言語をサポートします**。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტექსტი ჯერ გარდაიქმნება UTF-8-ში, შემდეგ კოდირდება Base64-ში, რის შემდეგაც თითოეული სიმბოლო იცვლება შესაბამისი ემოჯით.  **ეს ალგორითმი მხარს უჭერს ნებისმიერ სიმბოლოსა და ენას.**"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트는 먼저 UTF-8로 변환된 후 Base64로 인코딩되며, 그 후 각 문자가 해당하는 이모지로 대체됩니다。  이 알고리즘은 **모든 문자와 언어를 지원합니다**。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks mula-mula ditukar kepada UTF-8, kemudian dikodkan dalam Base64, selepas itu setiap aksara digantikan dengan emoji sepadan.  Algoritma ini **menyokong sebarang aksara dan bahasa**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst wordt eerst geconverteerd naar UTF-8, vervolgens gecodeerd in Base64, waarna elk teken wordt vervangen door een overeenkomstige emoji.  Dit algoritme **ondersteunt alle tekens en talen**."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto é primeiro convertido para UTF-8, depois codificado em Base64, após o que cada caractere é substituído por um emoji correspondente.  Este algoritmo **suporta qualquer caractere e idioma**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст сначала переводится в UTF-8, затем кодируется в Base64, после чего каждый символ заменяется соответствующим эмоджи.  Благодаря этому алгоритм **поддерживает любые символы и языки**."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten konverteras först till UTF-8, sedan kodas den i Base64, varefter varje tecken ersätts med en motsvarande emoji.  Denna algoritm **stöder alla tecken och språk**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin önce UTF-8'e dönüştürülür, ardından Base64 ile kodlanır ve her karakter karşılık gelen bir emoji ile değiştirilir.  Bu algoritma **herhangi bir karakteri ve dili destekler**."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст спочатку конвертується у UTF-8, потім кодується в Base64, після чого кожен символ замінюється відповідним емодзі.  Цей алгоритм **підтримує будь-які символи та мови**."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản trước tiên được chuyển đổi sang UTF-8, sau đó mã hóa thành Base64, sau đó mỗi ký tự được thay thế bằng emoji tương ứng.  Thuật toán này **hỗ trợ mọi ký tự và ngôn ngữ**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本首先被转换为 UTF-8，然后编码为 Base64，之后每个字符都会被替换为相应的表情符号。  该算法**支持任何字符和语言**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文本首先被轉換為 UTF-8，然後編碼為 Base64，之後每個字符都會被替換為相應的表情符號。  該算法**支持任何字符和語言**。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten konverteres først til UTF-8, deretter kodes den i Base64, og til slutt erstattes hvert tegn med tilsvarende emoji.  Denne algoritmen **støtter alle tegn og språk**."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst jest najpierw konwertowany do UTF-8, następnie kodowany w Base64, po czym każdy znak zastępowany jest odpowiadającym mu emoji.  Ten algorytm **obsługuje dowolne znaki i języki**."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul este mai întâi convertit în UTF-8, apoi este codificat în Base64, după care fiecare caracter este înlocuit cu emoji-ul corespunzător.  Acest algoritm **acceptă orice caractere și limbi**."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text sa najprv konvertuje do UTF-8, potom sa zakóduje do Base64 a napokon sa každý znak nahradí zodpovedajúcim emoji.  Tento algoritmus **podporuje akékoľvek znaky aj jazyky**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความจะถูกแปลงเป็น UTF-8 ก่อน จากนั้นเข้ารหัสเป็น Base64 แล้วจึงแทนที่แต่ละอักขระด้วยอีโมจิที่สอดคล้องกัน.  อัลกอริทึมนี้ **รองรับอักขระและทุกภาษา**."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Textanum er fyrst breytt í UTF-8, síðan kóðaður í Base64 og að lokum er hverjum staf skipt út fyrir samsvarandi emoji.  Þetta reiknirit **styður hvaða stafi og tungumál sem er**."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mətn əvvəlcə UTF-8-ə çevrilir, sonra Base64-ə kodlaşdırılır və hər bir simvol uyğun emoji ilə əvəzlənir.  Bu alqoritm **istənilən simvolu və dili dəstəkləyir**."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեքստը նախ փոխակերպվում է UTF-8-ի, ապա կոդավորվում է Base64-ով, և յուրաքանչյուր նշան փոխարինվում է համապատասխան emoji-ով.  Այս ալգորիթմը **աջակցում է ցանկացած նշանի և լեզվի**."
          }
        }
      }
    },
