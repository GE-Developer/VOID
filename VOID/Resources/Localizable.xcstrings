        },
        "uk" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ваш пристрій має **%lld ядра**. Збільшення кількості паралельних завдань може **прискорити шифрування**, але може витрачати більше батареї."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ваш пристрій має **%lld ядер**. Збільшення кількості паралельних завдань може **прискорити шифрування**, але може витрачати більше батареї."
                }
              },
              "one" : {
                "stringUnit" : {
