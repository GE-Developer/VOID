    "Settings.Storage.ClearData.alertMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إزالة الملفات المؤقتة والذاكرة المخبأة وملفات المستندات. ستُحفظ إعدادات التطبيق."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müvəqqəti fayllar, keş və sənədlər silinəcək. Tətbiq parametrləri saxlanacaq."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будуць выдалены часовыя файлы, кэш і файлы дакументаў. Налады праграмы будуць захаваны."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি অস্থায়ী ফাইল, ক্যাশ এবং ডকুমেন্ট ফাইল মুছে ফেলবে। অ্যাপের সেটিংস সংরক্ষিত থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'eliminaran fitxers temporals, memòria cau i documents. La configuració de l'app es conservarà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budou odstraněny dočasné soubory, mezipaměť a dokumenty. Nastavení aplikace bude zachováno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midlertidige filer, caches og dokumentfiler fjernes. App-indstillinger bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporäre Dateien, Caches und Dokumente werden entfernt. App-Einstellungen bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα αφαιρεθούν προσωρινά αρχεία, κρυφή μνήμη και έγγραφα. Οι ρυθμίσεις της εφαρμογής θα διατηρηθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove temporary files, caches, and document files. App settings will be preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán archivos temporales, cachés y documentos. Los ajustes de la app se conservarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väliaikaiset tiedostot, välimuistit ja dokumentit poistetaan. Sovelluksen asetukset säilytetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers temporaires, les caches et les documents seront supprimés. Les réglages de l'application seront conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תסיר קבצים זמניים, מטמונים וקבצי מסמכים. הגדרות האפליקציה ישמרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्थायी फ़ाइलें, कैश और दस्तावेज़ हटाए जाएँगे। ऐप सेटिंग्स सुरक्षित रहेंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklonit će se privremene datoteke, predmemorija i dokumenti. Postavke aplikacije bit će sačuvane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ideiglenes fájlok, a gyorsítótár és a dokumentumok törlésre kerülnek. Az alkalmazás beállításai megmaradnak."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կջնջվեն ժամանակավոր ֆայլերը, քեշը և փաստաթղթերը։ Հավելվածի կարգավորումները կպահպանվեն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File sementara, cache, dan dokumen akan dihapus. Pengaturan aplikasi akan tetap tersimpan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímabundnar skrár, skyndiminni og skjöl verða fjarlægð. Stillingar forritsins verða varðveittar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi file temporanei, cache e documenti. Le impostazioni dell'app verranno mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時ファイル、キャッシュ、ドキュメントが削除されます。アプリの設定は保持されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წაიშლება დროებითი ფაილები, ქეში და დოკუმენტები. აპლიკაციის პარამეტრები შენარჩუნდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уақытша файлдар, кэш және құжат файлдары жойылады. Қолданба параметрлері сақталады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "임시 파일, 캐시 및 문서가 삭제됩니다. 앱 설정은 유지됩니다."
