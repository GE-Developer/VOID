        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Data becomes inaccessible** after the chosen time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los **datos se vuelven inaccesibles** después del tiempo seleccionado."
          }
        },
        "fr" : {
