        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥长度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰長度"
          }
        }
