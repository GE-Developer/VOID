          }
        }
      }
    },
    "CryptoSettings.Layers.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum number of layers depends on the key length you select. A longer key allows more layers, increasing your protection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大レイヤー数は選択した鍵の長さに依存します。鍵が長いほどレイヤーを増やせ、保護が強化されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное количество слоёв зависит от выбранной длины ключа.\nЧем длиннее ключ, тем больше слоёв можно использовать, повышая уровень защиты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальна кількість рівнів залежить від обраної довжини ключа. Довший ключ дозволяє використовувати більше рівнів, підвищуючи захист."
          }
        }
      }
    },
