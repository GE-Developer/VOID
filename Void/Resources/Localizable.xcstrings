            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "你的设备拥有 **%lld 个核心**。 提高并行任务数量可以**加快加密速度**，但可能会增加电池消耗。"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "你的设备拥有 **%lld 个核心**。 提高并行任务数量可以**加快加密速度**，但可能会增加电池消耗。"
