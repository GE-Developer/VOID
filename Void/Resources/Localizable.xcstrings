    "CryptoSettings.KeyLength.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key length defines how hard it is to brute-force your data — the longer the key, the stronger the protection. Higher values increase security but may slightly slow down processing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵の長さはデータをブルートフォースで解読する難易度を決定します。長い鍵ほど保護は強くなります。値が大きいほどセキュリティは向上しますが、処理がわずかに遅くなる場合があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длина ключа определяет, насколько сложно взломать ваши данные перебором — чем длиннее ключ, тем выше защита. Большие значения повышают безопасность, но могут немного замедлить обработку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Довжина ключа означає, наскільки складно підібрати ваші дані методом brute-force — чим довший ключ, тим сильніший захист. Вищі значення підвищують безпеку, але можуть трохи сповільнити обробку."
          }
        }
      }
    },
    "CryptoSettings.KeyLength.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
