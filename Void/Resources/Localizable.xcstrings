{
  "sourceLanguage" : "en",
  "strings" : {
    "AES-256.Settings.dividerMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↓ For encryption only ↓"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↓ 暗号化のみ ↓"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↓ Только для шифрования ↓"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↓ Лише для шифрування ↓"
          }
        }
      }
    },
    "AES-256.Settings.Iterations.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of iterations affects encryption strength. More = harder to crack, but slower."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反復回数は暗号化の強さに影響します。多いほど解読が難しくなりますが、処理は遅くなります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количество итераций влияет на силу шифрования: чем больше итераций, тем сложнее взломать, но тем медленнее процесс шифрования и расшифровки данных."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість ітерацій впливає на стійкість шифрування. Більше = складніше зламати, але повільніше."
          }
        }
      }
    },
    "AES-256.Settings.Iterations.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iterations"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反復回数"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Итерации"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ітерації"
          }
        }
      }
    },
    "AES-256.Settings.Salt.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt is random data added to your password before encryption. It makes the result unique even if the password is the same, protecting against reuse attacks and password cracking. The longer the salt, the stronger the protection — harder to guess, harder to break."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソルトは、暗号化前にパスワードに追加されるランダムデータです。同じパスワードでも結果をユニークにし、再利用攻撃やパスワード解析から守ります。ソルトが長いほど保護は強くなり、推測や解読が難しくなります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соль — это случайные данные, которые добавляются к паролю перед шифрованием.\nОна делает результат уникальным даже при одинаковом пароле, защищая от атак повторного использования и взлома паролей.\nЧем длиннее соль, тем сильнее защита — труднее угадать, труднее взломать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сіль — це випадкові дані, які додаються до вашого пароля перед шифруванням. Вона робить результат унікальним навіть тоді, коли пароль однаковий, захищаючи від атак повторного використання та підбору паролів. Чим довша сіль, тим сильніший захист — важче вгадати, важче зламати."
          }
        }
      }
    },
    "AES-256.Settings.Salt.title" : {
