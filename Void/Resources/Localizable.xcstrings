    "CryptoSettings.Parallelism.instructions %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your device has **%lld core**. Increasing the number of parallel tasks can **speed up encryption**, but may consume more battery."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your device has **%lld cores**.  Increasing the number of parallel tasks can **speed up encryption**, but may consume more battery."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tu dispositivo tiene **%lld núcleo**.  \nAumentar el número de tareas paralelas puede **acelerar el cifrado**, pero puede consumir más batería."
                }
              },
              "other" : {
                "stringUnit" : {
