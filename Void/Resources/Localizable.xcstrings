    "CryptoSettings.Layers.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum **number of layers depends on the key length** you select. A longer key allows more layers, increasing your protection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El **número máximo de capas depende de la longitud de la clave** que selecciones.  \nUna clave más larga permite más capas, aumentando tu protección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre maximum de **couches dépend de la longueur de la clé** choisie. Une clé plus longue permet plus de couches, augmentant la protection."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिकतम **परतों की संख्या आपके द्वारा चुनी गई कुंजी की लंबाई पर निर्भर करती है**। लंबी कुंजी अधिक परतों की अनुमति देती है और आपकी सुरक्षा बढ़ाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero massimo di **livelli dipende dalla lunghezza della chiave** selezionata. Una chiave più lunga permette più livelli, aumentando la protezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大**レイヤー数は選択した鍵の長さに依存します**。 鍵が長いほど使用できるレイヤーが増え、保護が強化されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მაქსიმალური **შრეების რაოდენობა დამოკიდებულია საკვანძო სიგრძეზე**, რომელსაც ირჩევთ. გრძელი საკვანძო მეტი შრის დამატების საშუალებას იძლევა, რაც ზრდის დაცვას."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное **количество слоёв зависит от выбранной длины ключа**. Чем длиннее ключ, тем больше слоёв можно использовать, повышая уровень защиты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальна **кількість рівнів залежить від обраної довжини ключа**. Довший ключ дозволяє використовувати більше рівнів, підвищуючи захист."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持的最大**层数取决于所选的密钥长度**。 密钥越长，可用的层数越多，防护也越强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援的最大**層數取決於所選的金鑰長度**。 金鑰越長，可用的層數越多，防護也越強。"
          }
        }
      }
    },
