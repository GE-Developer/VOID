    "CryptoSettings.Security.Void.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID enhances the cryptographic key** by adding a hidden internal component.  A value of 0 means encryption is performed without VOID.  **The VOID number only affects the variant selection**, not the level of protection."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID усиливает криптографический ключ**, добавляя к нему скрытый внутренний компонент.  Значение 0 означает, что шифрование выполняется без VOID.  **Номер VOID влияет только на выбор варианта**, но не изменяет уровень защиты."
          }
        }
      }
    },
