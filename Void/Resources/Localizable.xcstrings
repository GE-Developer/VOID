    "AboutEmoji.aboutDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoji-Codierung ist **eine Methode zur visuellen Darstellung von Daten**, bei der Text in eine Reihe von Emojis umgewandelt wird.  **Diese Codierung ist nicht kryptografisch und bietet keinen Datenschutz**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoji encoding is **a method of visually representing data** where text is converted into a sequence of emojis.  **This encoding is not cryptographic and does not provide data protection**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La codificación con emojis es **un método de representación visual de datos**, donde el texto se convierte en una secuencia de emojis.  **Esta codificación no es criptográfica y no proporciona protección de datos**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le codage par emoji est **une méthode de représentation visuelle des données**, où le texte est converti en une séquence d'emojis.  **Ce codage n'est pas cryptographique et ne protège pas les données**."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इमोजी एन्कोडिंग **डेटा को दृश्य रूप में प्रस्तुत करने की एक विधि** है, जिसमें टेक्स्ट को इमोजी की एक श्रृंखला में परिवर्तित किया जाता है।  **यह एन्कोडिंग क्रिप्टोग्राफिक नहीं है और डेटा सुरक्षा प्रदान नहीं करती है**।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La codifica con emoji è **un metodo per rappresentare visivamente i dati**, dove il testo viene convertito in una sequenza di emoji.  **Questa codifica non è crittografica e non fornisce protezione dei dati**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絵文字エンコーディングは、テキストを絵文字のシーケンスに変換する**データを視覚的に表現する方法**です。  **このエンコーディングは暗号化ではなく、データ保護を提供しません**。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ემოჯის კოდირება **მონაცემთა ვიზუალური წარმოდგენის მეთოდია**, სადაც ტექსტი გარდაიქმნება ემოჯების თანმიმდევრობად.  **ეს კოდირება არ არის კრიპტოგრაფიული და არ უზრუნველყოფს მონაცემთა დაცვას**."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이모지 인코딩은 텍스트를 이모지 시퀀스로 변환하는 **데이터를 시각적으로 표현하는 방법**입니다。\n\n**이 인코딩은 암호화가 아니며 데이터 보호를 제공하지 않습니다**。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoji-codering is **een methode om gegevens visueel weer te geven**, waarbij tekst wordt omgezet in een reeks emoji's.  **Deze codering is niet cryptografisch en biedt geen gegevensbescherming**."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A codificação por emoji é **um método de representação visual de dados**, onde o texto é convertido em uma sequência de emojis.  **Essa codificação não é criptográfica e não fornece proteção de dados**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодирование в эмоджи —  **это способ визуального представления данных**, при котором текст преобразуется в последовательность эмоджи.  **Такое кодирование не является криптографическим и не обеспечивает защиту данных**."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoji-kodning är **en metod för att visuellt representera data**, där text omvandlas till en sekvens av emojis.  **Denna kodning är inte kryptografisk och ger inget dataskydd**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoji kodlaması, metnin bir dizi emojiye dönüştürüldüğü **verileri görsel olarak temsil etme yöntemi**dir.  **Bu kodlama kriptografik değildir ve veri koruması sağlamaz**."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодування емодзі — це **метод візуального подання даних**, коли текст перетворюється на послідовність емодзі.  **Це кодування не є криптографічним і не забезпечує захист даних**."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã hóa bằng emoji là **một phương pháp biểu diễn dữ liệu trực quan**, nơi văn bản được chuyển đổi thành một chuỗi emoji.  **Mã hóa này không phải là mã hóa và không cung cấp bảo vệ dữ liệu**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表情符号编码是一种**以可视化方式表示数据的方法**，文本会被转换为一系列表情符号。  **这种编码不是加密方法，也不能提供数据保护**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表情符號編碼是一種**以可視化方式表示數據的方法**，文本會被轉換為一系列表情符號。  **這種編碼不是加密方法，也不能提供數據保護**。"
          }
        }
      }
    },
