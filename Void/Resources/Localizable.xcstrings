    "Cryptography.AES-256.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Upon leaving this screen, all data (password, VOID, Argon2id parameters) will be reset.  The application does not store data in the phone's memory.**"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**Para su seguridad**  — Cuanto más fuerte sea la contraseña, más fuerte será el cifrado — No almacenamos ni transmitimos sus datos — Cuando abandone esta pantalla, todo se eliminará"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**Pour votre sécurité**  — Plus le mot de passe est complexe, plus le chiffrement est fort — Nous ne stockons ni ne transmettons vos données — Lorsque vous quittez cet écran, tout est supprimé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**Per la tua sicurezza**  — Più la password è complessa, più forte è la crittografia — Non memorizziamo né trasmettiamo i tuoi dati — Quando lasci questo schermo, tutto viene eliminato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**あなたのセキュリティのために**  — パスワードが強いほど、暗号化も強力です — 私たちはあなたのデータを保存したり送信したりしません — この画面を離れると、すべて削除されます"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**При покидании этого экрана все данные (пароль, VOID, параметры Argon2id) сбросятся.  Приложение не хранит данные в памяти телефона.**"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**Для вашої безпеки**  — Чим сильніший пароль, тим надійніше шифрування — Ми не зберігаємо і не передаємо ваші дані — Коли ви покидаєте цей екран, все видаляється"
          }
        }
      }
    },
