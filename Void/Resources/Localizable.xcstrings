                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tu dispositivo tiene **%lld núcleo**.  \nAumentar el número de tareas paralelas puede **acelerar el cifrado**, pero puede consumir más batería."
                }
              },
              "other" : {
                "stringUnit" : {
