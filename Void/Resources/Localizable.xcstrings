    "CryptoSettings.Security.Void.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID enhances the cryptographic key** by adding a hidden internal component.  A value of 0 means encryption is performed without VOID.  **The VOID number only affects the variant selection**, not the level of protection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID refuerza la clave criptográfica** al añadir un componente interno oculto.  Un valor de 0 significa que el cifrado se realiza sin VOID.  **El número de VOID solo afecta a la selección de la variante**, no al nivel de protección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID renforce la clé cryptographique** en ajoutant une composante interne cachée.  Une valeur de 0 signifie que le chiffrement est effectué sans VOID.  **Le numéro VOID influence uniquement le choix de la variante**, et non le niveau de protection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID rafforza la chiave crittografica** aggiungendo una componente interna nascosta.  Un valore pari a 0 significa che la cifratura viene eseguita senza VOID.  **Il numero VOID influisce solo sulla scelta della variante**, non sul livello di protezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID は隠された内部コンポーネントを加えることで暗号鍵を強化**します。  0 の値は、VOID なしで暗号化が行われることを意味します。  **VOID の数値はバリアントの選択にのみ影響し**、保護レベルは変わりません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**VOID აძლიერებს კრიპტოგრაფიულ გასაღებს**, რადგან მას დამატებით დამალულ შიდა კომპონენტს უმატებს.  0 ნიშნავს, რომ შიფრაცია VOID-ის გარეშე სრულდება.  **VOID-ის ნომერი მხოლოდ ვარიანტის არჩევას განსაზღვრავს** და არა დაცვის დონეს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID усиливает криптографический ключ**, добавляя к нему скрытый внутренний компонент.  Значение 0 означает, что шифрование выполняется без VOID.  **Номер VOID влияет только на выбор варианта**, но не изменяет уровень защиты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**VOID посилює криптографічний ключ**, додаючи прихований внутрішній компонент.  0 означає, що шифрування виконується без VOID.  **Номер VOID впливає лише на вибір варіанта**, а не на рівень захисту."
          }
        }
      }
    },
