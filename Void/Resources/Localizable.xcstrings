    "CryptoSettings.Iterations.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anzahl der **Iterationen** beeinflusst die **Stärke** der Verschlüsselung. Mehr Iterationen = schwerer zu knacken, aber **langsamer**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of **iterations** affects encryption **strength**. More = harder to crack, but **slower**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de **iteraciones** afecta la **fuerza** del cifrado.  \nMás iteraciones = más difícil de descifrar, pero **más lento**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre d'**itérations** influence la **force** du chiffrement. Plus d'itérations = plus difficile à craquer, mais **plus lent**."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**पुनरावृत्तियों** की संख्या एन्क्रिप्शन की **मज़बूती** को प्रभावित करती है। जितनी अधिक होंगी = तोड़ना उतना कठिन, लेकिन **गति धीमी**।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero di **iterazioni** influisce sulla **forza** della cifratura. Più iterazioni = più difficile da decifrare, ma **più lento**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**反復回数**は暗号化の**強度**に影響します。 回数が多いほど解読は難しくなりますが、**処理は遅く**なります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**იტერაციების რაოდენობა** გავლენას ახდენს **შიფრაციის სიმტკიცეზე**. რაოდენობის გაზრდა ართულებს დაშიფვრას, მაგრამ **ამცირებს სიჩქარეს**."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**반복 횟수**는 암호화의 **강도**에 영향을 줍니다. 횟수가 많을수록 풀기 어렵지만 **속도는 느려집니다**."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aantal **iteraties** beïnvloedt de **sterkte** van de versleuteling. Meer = moeilijker te kraken, maar **langzamer**."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**O número de iterações** afeta a **força** da criptografia. Quanto maior, mais difícil de quebrar, porém **mais lento**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Количество итераций** влияет на **силу** шифрования: чем больше итераций, тем сложнее взломать, но тем **медленнее** процесс шифрования и расшифровки данных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antalet **iterationer** påverkar krypteringens **styrka**. Fler = svårare att knäcka, men **långsammare**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**İterasyon sayısı** şifrelemenin **gücünü** etkiler. Daha fazla = kırması zor, ancak **daha yavaş**."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість **ітерацій** впливає на **стійкість** шифрування. Більше = складніше зламати, але **повільніше**."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Số vòng lặp** ảnh hưởng đến **độ mạnh** của mã hóa. Vòng lặp càng nhiều thì càng khó bẻ khóa nhưng quá trình sẽ **chậm hơn**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**迭代次数**会影响加密的**强度**。 迭代越多，越难破解，但速度会**变慢**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**迭代次數**會影響加密的**強度**。 迭代越多，越難破解，但速度會**變慢**。"
          }
        }
      }
    },
