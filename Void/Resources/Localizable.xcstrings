    "Cryptography.AES-256.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Wenn du diesen Bildschirm verlässt, werden alle Daten (Passwort, VOID, Argon2id-Parameter) zurückgesetzt.  Die App speichert keine Daten im Telefonspeicher.**"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Upon leaving this screen, all data (password, VOID, Argon2id parameters) will be reset.  The application does not store data in the phone's memory.**"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Al salir de esta pantalla, todos los datos (contraseña, VOID, parámetros de Argon2id) se restablecerán.  La aplicación no almacena datos en la memoria del teléfono.**"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**En quittant cet écran, toutes les données (mot de passe, VOID, paramètres Argon2id) seront réinitialisées.  L'application ne conserve pas les données dans la mémoire du téléphone.**"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**इस स्क्रीन से बाहर निकलते ही सभी डेटा (पासवर्ड, VOID, Argon2id पैरामीटर) रीसेट हो जाएंगे।  एप्लिकेशन फोन की मेमोरी में कोई डेटा संग्रहीत नहीं करता।**"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Quando lasci questa schermata, tutti i dati (password, VOID, parametri Argon2id) verranno reimpostati.  L'app non memorizza i dati nella memoria del telefono.**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**この画面を離れると、すべてのデータ（パスワード、VOID、Argon2id パラメータ）がリセットされます。  アプリはデータを端末のメモリに保存しません。**"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**თუ ამ ეკრანს დატოვებთ, ყველა მონაცემი (პაროლი, VOID, Argon2id-ის პარამეტრები) განულდება.  აპლიკაცია არ ინახავს მონაცემებს ტელეფონის მეხსიერებაში.**"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**이 화면을 떠나면 모든 데이터(비밀번호, VOID, Argon2id 매개변수)가 초기화됩니다.  앱은 휴대전화 메모리에 데이터를 저장하지 않습니다.**"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Wanneer je dit scherm verlaat, worden alle gegevens (wachtwoord, VOID, Argon2id-parameters) gereset.  De app slaat geen gegevens op in het geheugen van de telefoon.**"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ao sair desta tela, todos os dados (senha, VOID, parâmetros Argon2id) serão redefinidos.  O aplicativo não armazena dados na memória do telefone.**"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**При покидании этого экрана все данные (пароль, VOID, параметры Argon2id) сбросятся.  Приложение не хранит данные в памяти телефона.**"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**När du lämnar den här skärmen återställs all data (lösenord, VOID, Argon2id-parametrar).  Appen lagrar inte data i telefonens minne.**"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Bu ekrandan ayrıldığınızda tüm veriler (parola, VOID, Argon2id parametreleri) sıfırlanır.  Uygulama verileri telefonun belleğinde saklamaz.**"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**При виході з цього екрану всі дані (пароль, VOID, параметри Argon2id) скинуться.  Додаток не зберігає дані в пам'яті телефону.**"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Khi rời khỏi màn hình này, toàn bộ dữ liệu (mật khẩu, VOID, tham số Argon2id) sẽ được đặt lại.  Ứng dụng không lưu dữ liệu trong bộ nhớ điện thoại.**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**离开此页面时，所有数据（密码、VOID、Argon2id 参数）都会被重置。  应用不会在手机内存中存储数据。**"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**離開此頁面時，所有資料（密碼、VOID、Argon2id 引數）都會被重置。  應用不會在手機記憶體中儲存資料。**"
          }
        }
      }
