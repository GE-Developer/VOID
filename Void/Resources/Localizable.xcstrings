    "EmojiCoding.headerText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text in Emojis zu codieren ist eine **visuelle Darstellung von Daten**, ähnlich wie Base64.  **Es bietet keinen kryptografischen Schutz**.  Es kann mit Verschlüsselung kombiniert werden, um die Sicherheit zu erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encoding text into emojis is a **visual representation of data**, similar to Base64.  **It does not provide cryptographic protection**.  It can be combined with encryption for stronger security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codificar texto en emojis es una **representación visual de datos**, similar a Base64.  **No proporciona protección criptográfica**.  Se puede combinar con cifrado para mayor seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encoder du texte en emojis est une **représentation visuelle des données**, similaire à Base64.  **Cela ne fournit pas de protection cryptographique**.  Il peut être combiné avec le chiffrement pour une sécurité renforcée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट को इमोजी में एन्कोड करना **डेटा का दृश्य प्रतिनिधित्व** है, Base64 के समान।  **यह क्रिप्टोग्राफिक सुरक्षा प्रदान नहीं करता**।  इसे मजबूत सुरक्षा के लिए एन्क्रिप्शन के साथ जोड़ा जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codificare il testo in emoji è una **rappresentazione visiva dei dati**, simile a Base64.  **Non fornisce protezione crittografica**.  Può essere combinato con la crittografia per una maggiore sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを絵文字にエンコードすることは、Base64と同様に**データを視覚的に表現する方法**です。  **これは暗号化による保護を提供しません**。  より強力なセキュリティのために暗号化と組み合わせることができます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ტექსტის ემოჯებად კოდირება **მონაცემთა ვიზუალური წარმოდგენაა**, Base64-ის მსგავსი.   **ის არ უზრუნველყოფს კრიპტოგრაფიულ დაცვას**.  შეიძლება გაერთიანდეს შიფრაციასთან უფრო ძლიერი უსაფრთხოებისთვის."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트를 이모지로 인코딩하는 것은 Base64와 유사한 **데이터의 시각적 표현**입니다。  **암호화 보호를 제공하지 않습니다**。  더 강력한 보안을 위해 암호화와 결합할 수 있습니다。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst coderen naar emoji is een **visuele representatie van gegevens**, vergelijkbaar met Base64.  **Het biedt geen cryptografische bescherming**.  Het kan worden gecombineerd met encryptie voor sterkere beveiliging."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codificar texto em emojis é uma **representação visual de dados**, semelhante ao Base64.  **Não fornece proteção criptográfica**.  Pode ser combinado com criptografia para maior segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодирование текста в эмоджи — **визуальное представление данных**, подобное Base64.  **Не обеспечивает криптографической защиты**.  Может использоваться совместно с шифрованием для повышения криптостойкости."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att koda text till emojis är en **visuell representation av data**, liknande Base64.  **Det ger inget kryptografiskt skydd**.  Det kan kombineras med kryptering för starkare säkerhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metni emojilere kodlamak, Base64'e benzer şekilde **verilerin görsel temsili**dir.  **Kriptografik koruma sağlamaz**.  Daha güçlü güvenlik için şifreleme ile birleştirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодування тексту у емодзі — це **візуальне подання даних**, подібне до Base64.  **Це не забезпечує криптографічного захисту**.  Може бути поєднано з шифруванням для більшої безпеки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã hóa văn bản thành emoji là **một phương pháp biểu diễn dữ liệu trực quan**, tương tự như Base64.  **Nó không cung cấp bảo vệ mật mã**.  Có thể kết hợp với mã hóa để tăng cường bảo mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文本编码为表情符号是一种**数据的可视化表示方式**，类似于 Base64。  **它不提供加密保护**。  可以与加密结合使用以增强安全性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將文本編碼為表情符號是一種**數據的可視化表示方式**，類似於 Base64。  **它不提供加密保護**。  可以與加密結合使用以增強安全性。"
          }
        }
      }
    },
